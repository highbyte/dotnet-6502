   487                          SpriteShape:
   488  c492 007e00             	!byte %00000000, %01111110, %00000000
   489  c495 01ff80             	!byte %00000001, %11111111, %10000000
   490  c498 03ffc0             	!byte %00000011, %11111111, %11000000
   491  c49b 07ffe0             	!byte %00000111, %11111111, %11100000
   492  c49e 0ffff0             	!byte %00001111, %11111111, %11110000
   493  c4a1 1ffff8             	!byte %00011111, %11111111, %11111000
   494  c4a4 1ffff8             	!byte %00011111, %11111111, %11111000
   495  c4a7 3ffffc             	!byte %00111111, %11111111, %11111100
   496  c4aa 3ffffc             	!byte %00111111, %11111111, %11111100
   497  c4ad 3ffffc             	!byte %00111111, %11111111, %11111100
   498  c4b0 3ffffc             	!byte %00111111, %11111111, %11111100
   499  c4b3 3ffffc             	!byte %00111111, %11111111, %11111100
   500  c4b6 3ffffc             	!byte %00111111, %11111111, %11111100
   501  c4b9 3ffffc             	!byte %00111111, %11111111, %11111100
   502  c4bc 1ffff8             	!byte %00011111, %11111111, %11111000
   503  c4bf 1ffff8             	!byte %00011111, %11111111, %11111000
   504  c4c2 0ffff0             	!byte %00001111, %11111111, %11110000
   505  c4c5 07ffe0             	!byte %00000111, %11111111, %11100000
   506  c4c8 03ffc0             	!byte %00000011, %11111111, %11000000
   507  c4cb 01ff80             	!byte %00000001, %11111111, %10000000
   508  c4ce 007e00             	!byte %00000000, %01111110, %00000000
