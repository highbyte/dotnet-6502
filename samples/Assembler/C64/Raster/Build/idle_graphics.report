
; ******** Source: idle_graphics.asm
     1                          ;ACME assembler
     2                          ;!to "./idle_graphics.prg"
     3                          
     4                          ; VIC-II display enable (DEN) test: the same cycle-counted colour loop with the display on and off.
     5                          ;
     6                          ; DEN is bit 4 of $d011. The VIC-II does not read it continuously: it samples it during raster
     7                          ; line 48 ($30), and what it saw there decides for the whole frame whether any line can be a bad
     8                          ; line, that is whether character rows are fetched and displayed at all. Separately, DEN gates the
     9                          ; vertical border: the border flip-flop opens at line 51 only if DEN is set at that moment.
    10                          ;
    11                          ; With the display on, every 8th line of the display area is a bad line: the VIC-II takes the bus
    12                          ; for about 40 cycles in the middle of it and the CPU stops at its next opcode fetch. Nothing a
    13                          ; program does inside those lines can avoid that. With DEN clear during line 48 there are no bad
    14                          ; lines, the CPU owns every cycle of the frame, and cycle-counted code runs straight through the
    15                          ; display area. That is what this program shows, by running the same loop in every phase:
    16                          ;
    17                          ;   200 iterations of exactly one raster line (63 cycles on PAL, 65 on NTSC; the model is detected
    18                          ;   at start), each writing eight background colours 6 cycles apart, so the display area shows
    19                          ;   48-pixel vertical colour columns. The loop is entered from a line-clock sync (see
    20                          ;   raster_columns.asm), so the columns land on the same cycle every frame.
    21                          ;
    22                          ; Five phases. The first stays until the space bar is pressed; the other four follow at about
    23                          ; two seconds each, after which the first waits for space again:
    24                          ;
    25                          ;   1. DEN set all frame: the text screen over the columns. Every bad line halts the loop for
    26                          ;      about 40 cycles, so from there on the colour writes are 40 cycles late and the columns
    27                          ;      shear sideways, 25 times down the screen.
    28                          ;   2. DEN cleared on line 40 and set again a few cycles into line 48: the same picture, because a
    29                          ;      write during line 48 counts and the frame has its bad lines.
    30                          ;   3. DEN cleared until line 49: the border opens at 51, but the frame has no bad lines, so the
    31                          ;      columns are straight. No character row is fetched either: the display area shows "idle
    32                          ;      graphics", the byte at $3fff in every cell, black over the background colour. The loop
    33                          ;      writes one row of an 8x8 glyph to $3fff on every line, so all 1000 cells show the same
    34                          ;      glyph without any screen RAM or character set being read.
    35                          ;   4. DEN cleared all frame: the border never opens, so the loop writes the border colour instead
    36                          ;      and the columns run edge to edge.
    37                          ;   5. As 3, but $d011 selects 24 rows from the end of line 250 until line 253. The vertical
    38                          ;      border flip-flop is set only when the raster reaches the bottom compare line, 251 with 25
    39                          ;      rows and 247 with 24, and neither is the case while the register changes, so the flip-flop
    40                          ;      stays clear for the rest of the frame and the next one: the display window's columns run
    41                          ;      on through the bottom and top borders, and the eight sprites parked there, covered by the
    42                          ;      border in every other phase, are shown. (The side borders need the same trick with the
    43                          ;      38-column bit at the right cycle of every line and are not opened here.)
    44                          ;
    45                          ; Phases 3 and 4 are why loaders and demo parts switch the display off: the ~1000 cycles per
    46                          ; frame of bad lines come back. An emulator that reads DEN live shows sheared columns and the
    47                          ; text screen in phase 3, with its status line saying "3".
    48                          ;
    49                          ; Timing inside the loop: the idle byte is written after the previous line's display window and
    50                          ; the first colour before the next line's visible part begins, so both the idle graphics and the
    51                          ; phase 4 border columns have straight top and left edges.
    52                          
    53                          ;code start address
    54                          * = $c000
    55                          
    56                          ;------------------------------------------------------------
    57                          ;Program settings
    58                          ;------------------------------------------------------------
    59                          
    60                          SCREEN_RAM      = $0400
    61                          COLOR_RAM       = $d800
    62                          
    63                          SCREEN_CONTROL_REGISTER_1 = $d011
    64                          SCREEN_RASTER_LINE = $d012
    65                          SCREEN_BORDER_COLOR_ADDRESS = $d020
    66                          SCREEN_BACKGROUND_COLOR_ADDRESS = $d021
    67                          
    68                          CIA1_TIMER_A_LO = $dc04
    69                          CIA1_TIMER_A_HI = $dc05
    70                          CIA1_CONTROL_A = $dc0e
    71                          
    72                          IDLE_BYTE_ADDRESS = $3fff       ; the byte the VIC-II displays in idle state
    73                          
    74                          ; $d011 values: raster bit 8 clear, YSCROLL 3; 25 rows with DEN on and off, and 24 rows with DEN on.
    75                          D011_DEN_ON  = %00011011
    76                          D011_DEN_OFF = %00001011
    77                          D011_ROWS_24 = %00010011
    78                          
    79                          IRQ_LINE          = 40          ; top border on both models; well before line 48
    80                          DEN_SAMPLE_LINE   = 48          ; the line during which the VIC-II samples DEN
    81                          SYNC_LINE         = 50          ; the loop is entered from this line, one above the display area
    82                          FIRST_SCREEN_LINE = 51
    83                          SCREEN_LINES      = 200
    84                          
    85                          CYCLES_PER_LINE_PAL = 63
    86                          CYCLES_PER_LINE_NTSC = 65
    87                          LOOP_CYCLES = 63                ; one iteration of the column loop without filler
    88                          
    89                          PHASES       = 5
    90                          PHASE_FRAMES = 100              ; frames per phase 2-5 (2 s PAL, 1.7 s NTSC)
    91                          STATUS_ROW   = 24
    92                          STATUS_COL   = 19               ; after "space=run 2-5. now:"
    93                          ROWS_25_AGAIN_LINE = 253        ; phase 5: back to 25 rows once line 251 has passed
    94                          
    95                          SPRITE_POINTERS   = $07f8       ; sprite pointers for the video matrix at $0400
    96                          SPRITE_SHAPE_ADDRESS = $3000    ; block 192
    97                          SPRITE_SHAPE_BLOCK   = SPRITE_SHAPE_ADDRESS / 64
    98                          ; Sprite DMA takes the bus from the CPU on the lines a sprite is displayed on, whether the border
    99                          ; covers it or not, so both rows are kept clear of line 50, where the column loop is synchronised,
   100                          ; and of lines 51-250, where it runs.
   101                          SPRITE_TOP_Y      = 27          ; sprites 0-3: raster lines 28-48, in the top border on both models
   102                          SPRITE_BOTTOM_Y   = 253         ; sprites 4-7: raster lines 254-274, in the bottom border
   103                          
   104                          CIA1_PORT_A = $dc00             ; keyboard matrix row select
   105                          CIA1_PORT_B = $dc01             ; keyboard matrix column read
   106                          SPACE_ROW_SELECT = %01111111    ; the space bar is row 7, column 4
   107                          SPACE_COLUMN_BIT = %00010000
   108                          
   109                          FILLER       = $02      ; zero page: scratch, also the byte the timing filler reads
   110                          START        = $03      ; zero page: set by the main loop when space starts the cycle
   111                          CONTROL_AFTER = $04     ; zero page: $d011 value the column loop writes as it ends, on line 250
   112                          ENTRY        = $f7      ; zero page, 2 bytes: the column loop to run this frame
   113                          PHASE        = $f9      ; zero page: current phase 0-3
   114                          FRAME        = $fa      ; zero page: frames spent in the current phase
   115                          IS_PAL       = $fb      ; zero page: 1 on PAL, 0 on NTSC
   116                          LAST_LINE_LO = $fc      ; zero page: scratch for the model detection
   117                          CALIB        = $fd      ; zero page: line clock value of the reference poll (see SyncToLine)
   118                          TARGET_LINE  = $fe      ; zero page: raster line SyncToLine waits for
   119                          
   120                          ; Slide entry for a frame exactly as early as the reference frame. The poll loop is 7 cycles, so a
   121                          ; frame differs from the reference by at most 6 cycles either way and the entry stays within 3-15.
   122                          SLIDE_CENTER = 9
   123                          
   124                          COLOR_BLACK     = 0
   125                          COLOR_WHITE     = 1
   126                          COLOR_DARK_GREY = 11
   127                          SPACE_CHAR      = $20
   128                          
   129                          ;------------------------------------------------------------
   130                          ;Macros
   131                          ;------------------------------------------------------------
   132                          
   133                          ; Burn .cycles cycles (>= 2). NOPs in pairs, with a 3-cycle BIT for an odd count.
   134                          !macro delay_cycles .cycles {
   135                          	!if .cycles & 1 {
   136                          		bit FILLER
   137                          		!fill (.cycles - 3) / 2, $ea
   138                          	} else {
   139                          		!fill .cycles / 2, $ea
   140                          	}
   141                          }
   142                          
   143                          ; Busy-wait until the raster reaches .line (0-255). Exits 2-8 cycles into the line.
   144                          !macro wait_line .line {
   145                          	lda #.line
   146                          -	cmp SCREEN_RASTER_LINE
   147                          	bne -
   148                          }
   149                          
   150                          ; Wait for the raster line in TARGET_LINE, then read the line clock. Written once and used both by
   151                          ; the calibration in Init and by SyncToLine, so the clock is always read at the same offset after
   152                          ; the poll and the two values can be compared directly.
   153                          !macro poll_and_read_clock {
   154                          	lda TARGET_LINE                 ; 3
   155                          -	cmp SCREEN_RASTER_LINE          ; 4
   156                          	bne -                           ; 3 taken / 2 falling through
   157                          	lda CIA1_TIMER_A_LO             ; 4   (the read lands on the 4th cycle)
   158                          }
   159                          
   160                          ; Copy a $ff-terminated screen-code string to screen memory.
   161                          !macro print .screenaddr, .text {
   162                          	ldx #0
   163                          -	lda .text,x
   164                          	cmp #$ff
   165                          	beq +
   166                          	sta .screenaddr,x
   167                          	inx
   168                          	bne -
   169                          +
   170                          }
   171                          
   172                          ; The column loop: 200 iterations of exactly one raster line. Iteration x runs on line 50 + x and
   173                          ; prepares line 51 + x: its idle byte (written 60-66 cycles into the line, after the display window
   174                          ; has ended), then eight colours 6 cycles apart, the first of them 3-9 cycles into the next line,
   175                          ; before its visible part. The loop's own counter and branch take the last 7 cycles. Afterwards the
   176                          ; border and background go back to their resting colours, the border write timed to land in the
   177                          ; unseen pixels after line 250's visible right border. Before that the control register is written
   178                          ; with the value the phase asked for: phase 5 needs 24 rows selected before line 251 begins.
   179                          !macro column_loop .colour_addr, .fill, ~.entry {
   180                          	!align 127, 0        ; the loop is under 128 bytes: no page crossing on the branch back
   181                          .entry
   182                          .Line:
   183                          	lda IdleBytes,x                     ; 4
   184                          	sta IDLE_BYTE_ADDRESS               ; 4
   185                          	lda #COLOR_WHITE                    ; 2
   186                          	sta .colour_addr                    ; 4
   187                          	lda #7                              ; yellow
   188                          	sta .colour_addr
   189                          	lda #8                              ; orange
   190                          	sta .colour_addr
   191                          	lda #10                             ; light red
   192                          	sta .colour_addr
   193                          	lda #13                             ; light green
   194                          	sta .colour_addr
   195                          	lda #3                              ; cyan
   196                          	sta .colour_addr
   197                          	lda #14                             ; light blue
   198                          	sta .colour_addr
   199                          	lda #15                             ; light grey
   200                          	sta .colour_addr
   201                          	!if .fill {
   202                          		+delay_cycles .fill
   203                          	}
   204                          	inx                                 ; 2
   205                          	cpx #SCREEN_LINES                   ; 2
   206                          	bne .Line                           ; 3 taken / 2 falling through
   207                          	lda CONTROL_AFTER                   ; $d011 as the phase wants it from line 250's end (59-65 cycles in)
   208                          	sta SCREEN_CONTROL_REGISTER_1
   209                          	lda #COLOR_DARK_GREY                ; the border write lands 65-71 cycles into line 250
   210                          	sta SCREEN_BORDER_COLOR_ADDRESS
   211                          	lda #COLOR_BLACK
   212                          	sta SCREEN_BACKGROUND_COLOR_ADDRESS
   213                          	jmp ColumnsDone
   214                          }
   215                          
   216                          ; 8x8 glyphs as idle bytes, one row per raster line; five glyphs, repeated down the screen.
   217                          !macro heart {
   218                          	!byte %00000000, %01100110, %11111111, %11111111, %01111110, %00111100, %00011000, %00000000
   219                          }
   220                          !macro smiley {
   221                          	!byte %00000000, %00111100, %01000010, %10100101, %10011001, %01000010, %00111100, %00000000
   222                          }
   223                          !macro diamond {
   224                          	!byte %00000000, %00011000, %00111100, %01111110, %01111110, %00111100, %00011000, %00000000
   225                          }
   226                          !macro arrow {
   227                          	!byte %00000000, %00011000, %00111100, %01111110, %00011000, %00011000, %00011000, %00000000
   228                          }
   229                          !macro cross {
   230                          	!byte %00000000, %01000010, %00100100, %00011000, %00011000, %00100100, %01000010, %00000000
   231                          }
   232                          
   233                          ;------------------------------------------------------------
   234                          ;Code start
   235                          ;------------------------------------------------------------
   236                          
   237                          Init:
   238  c000 78                 	sei                  ; set interrupt bit, make the CPU ignore interrupt requests
   239  c001 a97f               	lda #%01111111       ; switch off interrupt signals from CIA-1
   240  c003 8d0ddc             	sta $dc0d
   241                          
   242  c006 2d11d0             	and SCREEN_CONTROL_REGISTER_1 ; clear most significant bit of VIC's raster register
   243  c009 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   244                          
   245  c00c ad0ddc             	lda $dc0d            ; acknowledge pending interrupts from CIA-1
   246  c00f ad0ddd             	lda $dd0d            ; acknowledge pending interrupts from CIA-2
   247                          
   248  c012 2099c0             	jsr DetectModel
   249                          
   250  c015 a90b               	lda #COLOR_DARK_GREY
   251  c017 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   252  c01a a900               	lda #COLOR_BLACK
   253  c01c 8d21d0             	sta SCREEN_BACKGROUND_COLOR_ADDRESS
   254  c01f 8dff3f             	sta IDLE_BYTE_ADDRESS
   255  c022 85f9               	sta PHASE
   256  c024 85fa               	sta FRAME
   257  c026 8503               	sta START
   258                          
   259  c028 20bdc0             	jsr ClearScreen
   260  c02b 20e2c0             	jsr DrawScreen
   261  c02e 207ac2             	jsr PrintStatus
   262  c031 202dc2             	jsr SetupSprites
   263                          
   264                          	; Line clock: timer A counts one raster line per period (latch + 1 cycles), continuously.
   265  c034 a900               	lda #0
   266  c036 8d05dc             	sta CIA1_TIMER_A_HI
   267  c039 a940               	lda #CYCLES_PER_LINE_NTSC - 1
   268  c03b a6fb               	ldx IS_PAL
   269  c03d f002               	beq +
   270  c03f a93e               	lda #CYCLES_PER_LINE_PAL - 1
   271  c041 8d04dc             +	sta CIA1_TIMER_A_LO
   272                          
   273  c044 a911               	lda #%00010001       ; force load + start, continuous
   274  c046 8d0edc             	sta CIA1_CONTROL_A
   275                          
   276                          	; Calibration: run the poll once and keep the clock value it produces. Every later poll is
   277                          	; compared against this, so the loop aligns to this frame whatever the code layout is.
   278  c049 a932               	lda #SYNC_LINE
   279  c04b 85fe               	sta TARGET_LINE
   280  c04d a5fecd12d0d0fbad...	+poll_and_read_clock
   281  c057 85fd               	sta CALIB
   282                          
   283                          	; Raster IRQ in the top border, before the DEN sample line
   284  c059 a928               	lda #IRQ_LINE
   285  c05b 8d12d0             	sta SCREEN_RASTER_LINE
   286  c05e a913               	lda #<Irq
   287  c060 8d1403             	sta $0314
   288  c063 a9c3               	lda #>Irq
   289  c065 8d1503             	sta $0315
   290                          
   291  c068 a90f               	lda #%00001111       ; clear any pending VIC interrupt flag
   292  c06a 8d19d0             	sta $d019
   293  c06d a901               	lda #%00000001       ; enable raster interrupt signals from VIC
   294  c06f 8d1ad0             	sta $d01a
   295                          
   296  c072 58                 	cli                  ; clear interrupt flag, allowing the CPU to respond to interrupt requests
   297                          
   298                          ; Main loop: while phase 1 is showing, a press of the space bar (after it has been released) starts
   299                          ; the cycle; the interrupt takes it from there and the loop waits for phase 1 to come round again.
   300                          Main:
   301  c073 a5f9               -	lda PHASE
   302  c075 d0fc               	bne -
   303  c077 2085c0             	jsr WaitSpace
   304  c07a a901               	lda #1
   305  c07c 8503               	sta START
   306  c07e a5f9               -	lda PHASE
   307  c080 f0fc               	beq -
   308  c082 4c73c0             	jmp Main
   309                          
   310                          ; Wait for the space bar to be up, then down, reading the keyboard matrix directly (the KERNAL's
   311                          ; scan is off with the CIA interrupt).
   312                          WaitSpace:
   313  c085 a97f               	lda #SPACE_ROW_SELECT
   314  c087 8d00dc             	sta CIA1_PORT_A
   315  c08a ad01dc             -	lda CIA1_PORT_B
   316  c08d 2910               	and #SPACE_COLUMN_BIT
   317  c08f f0f9               	beq -                ; still held from before
   318  c091 ad01dc             -	lda CIA1_PORT_B
   319  c094 2910               	and #SPACE_COLUMN_BIT
   320  c096 d0f9               	bne -                ; not pressed yet
   321  c098 60                 	rts
   322                          
   323                          ; PAL or NTSC: after the raster passes line 255, remember the last low byte seen before it wraps
   324                          ; to 0. NTSC wraps after line 262 (low byte 6), PAL after line 311 (low byte 55).
   325                          DetectModel:
   326  c099 a900               	lda #0
   327  c09b 85fc               	sta LAST_LINE_LO
   328  c09d 2c11d0             -	bit SCREEN_CONTROL_REGISTER_1
   329  c0a0 10fb               	bpl -
   330                          	; Keep the highest line low byte seen while bit 8 is set, rather than the last one: the raster
   331                          	; can wrap to 0 between reading the line and testing bit 8, and the last value would then be 0
   332                          	; on either model.
   333  c0a2 ad12d0             -	lda SCREEN_RASTER_LINE
   334  c0a5 c5fc               	cmp LAST_LINE_LO
   335  c0a7 9002               	bcc +
   336  c0a9 85fc               	sta LAST_LINE_LO
   337  c0ab 2c11d0             +	bit SCREEN_CONTROL_REGISTER_1
   338  c0ae 30f2               	bmi -
   339  c0b0 a900               	lda #0
   340  c0b2 85fb               	sta IS_PAL
   341  c0b4 a5fc               	lda LAST_LINE_LO
   342  c0b6 c920               	cmp #$20
   343  c0b8 9002               	bcc +
   344  c0ba e6fb               	inc IS_PAL
   345  c0bc 60                 +	rts
   346                          
   347                          ; Fill screen RAM with spaces and colour RAM with black, so the text reads over the columns.
   348                          ClearScreen:
   349  c0bd a200               	ldx #0
   350  c0bf a920               	lda #SPACE_CHAR
   351  c0c1 9d0004             -	sta SCREEN_RAM,x
   352  c0c4 9d0005             	sta SCREEN_RAM + $100,x
   353  c0c7 9d0006             	sta SCREEN_RAM + $200,x
   354  c0ca 9d0007             	sta SCREEN_RAM + $300,x
   355  c0cd e8                 	inx
   356  c0ce d0f1               	bne -
   357  c0d0 a900               	lda #COLOR_BLACK
   358  c0d2 9d00d8             -	sta COLOR_RAM,x
   359  c0d5 9d00d9             	sta COLOR_RAM + $100,x
   360  c0d8 9d00da             	sta COLOR_RAM + $200,x
   361  c0db 9d00db             	sta COLOR_RAM + $300,x
   362  c0de e8                 	inx
   363  c0df d0f1               	bne -
   364  c0e1 60                 	rts
   365                          
   366                          DrawScreen:
   367  c0e2 a200bdc8c7c9fff0...	+print SCREEN_RAM + 0 * 40, Text0
   368  c0f1 a200bde9c7c9fff0...	+print SCREEN_RAM + 2 * 40, Text2
   369  c100 a200bd0ec8c9fff0...	+print SCREEN_RAM + 3 * 40, Text3
   370  c10f a200bd33c8c9fff0...	+print SCREEN_RAM + 4 * 40, Text4
   371  c11e a200bd5ac8c9fff0...	+print SCREEN_RAM + 5 * 40, Text5
   372  c12d a200bd7bc8c9fff0...	+print SCREEN_RAM + 7 * 40, Text7
   373  c13c a200bda3c8c9fff0...	+print SCREEN_RAM + 8 * 40, Text8
   374  c14b a200bdc9c8c9fff0...	+print SCREEN_RAM + 9 * 40, Text9
   375  c15a a200bdf0c8c9fff0...	+print SCREEN_RAM + 11 * 40, Text11
   376  c169 a200bd18c9c9fff0...	+print SCREEN_RAM + 12 * 40, Text12
   377  c178 a200bd40c9c9fff0...	+print SCREEN_RAM + 13 * 40, Text13
   378  c187 a200bd61c9c9fff0...	+print SCREEN_RAM + 14 * 40, Text14
   379  c196 a200bd86c9c9fff0...	+print SCREEN_RAM + 15 * 40, Text15
   380  c1a5 a200bdaec9c9fff0...	+print SCREEN_RAM + 16 * 40, Text16
   381  c1b4 a200bdd3c9c9fff0...	+print SCREEN_RAM + 17 * 40, Text17
   382  c1c3 a200bdfbc9c9fff0...	+print SCREEN_RAM + 18 * 40, Text18
   383  c1d2 a200bd23cac9fff0...	+print SCREEN_RAM + 19 * 40, Text19
   384  c1e1 a200bd47cac9fff0...	+print SCREEN_RAM + 20 * 40, Text20
   385  c1f0 a200bd6ecac9fff0...	+print SCREEN_RAM + 21 * 40, Text21
   386  c1ff a200bd94cac9fff0...	+print SCREEN_RAM + 22 * 40, Text22
   387  c20e a200bdbdcac9fff0...	+print SCREEN_RAM + 23 * 40, Text23
   388  c21d a200bde4cac9fff0...	+print SCREEN_RAM + 24 * 40, Text24
   389  c22c 60                 	rts
   390                          
   391                          ; Eight sprites of one shape, four across the top border and four across the bottom, enabled
   392                          ; for good: the border covers them, so they show only while phase 5 keeps it open.
   393                          SetupSprites:
   394  c22d a23e               	ldx #62
   395  c22f bdc6c5             -	lda SpriteShape,x
   396  c232 9d0030             	sta SPRITE_SHAPE_ADDRESS,x
   397  c235 ca                 	dex
   398  c236 10f7               	bpl -
   399  c238 a207               	ldx #7
   400  c23a a9c0               -	lda #SPRITE_SHAPE_BLOCK
   401  c23c 9df807             	sta SPRITE_POINTERS,x
   402  c23f bd05c6             	lda SpriteColours,x
   403  c242 9d27d0             	sta $d027,x
   404  c245 ca                 	dex
   405  c246 10f2               	bpl -
   406  c248 a200               	ldx #0
   407  c24a a000               	ldy #0
   408  c24c bd0dc6             -	lda SpriteX,x
   409  c24f 9900d0             	sta $d000,y          ; X
   410  c252 a91b               	lda #SPRITE_TOP_Y
   411  c254 e004               	cpx #4
   412  c256 9002               	bcc +
   413  c258 a9fd               	lda #SPRITE_BOTTOM_Y
   414  c25a 9901d0             +	sta $d001,y          ; Y
   415  c25d c8                 	iny
   416  c25e c8                 	iny
   417  c25f e8                 	inx
   418  c260 e008               	cpx #8
   419  c262 d0e8               	bne -
   420  c264 a988               	lda #%10001000
   421  c266 8d10d0             	sta $d010            ; X MSB for sprites 3 and 7
   422  c269 a900               	lda #0
   423  c26b 8d17d0             	sta $d017            ; no expansion
   424  c26e 8d1dd0             	sta $d01d
   425  c271 8d1cd0             	sta $d01c            ; single colour
   426  c274 a9ff               	lda #%11111111
   427  c276 8d15d0             	sta $d015            ; all eight enabled
   428  c279 60                 	rts
   429                          
   430                          ; Status line for the current phase. Only phases 1 and 2 ever show it on hardware: in phase 3
   431                          ; the text screen is not fetched and in phase 4 the border covers it.
   432                          PrintStatus:
   433  c27a a5f9               	lda PHASE
   434  c27c c901               	cmp #1
   435  c27e f01c               	beq PrintStatus2
   436  c280 c902               	cmp #2
   437  c282 f028               	beq PrintStatus3
   438  c284 c903               	cmp #3
   439  c286 f034               	beq PrintStatus4
   440  c288 c904               	cmp #4
   441  c28a f040               	beq PrintStatus5
   442  c28c a200bdf8cac9fff0...	+print SCREEN_RAM + STATUS_ROW * 40 + STATUS_COL, Status1
   443  c29b 60                 	rts
   444                          PrintStatus2:
   445  c29c a200bd0ecbc9fff0...	+print SCREEN_RAM + STATUS_ROW * 40 + STATUS_COL, Status2
   446  c2ab 60                 	rts
   447                          PrintStatus3:
   448  c2ac a200bd24cbc9fff0...	+print SCREEN_RAM + STATUS_ROW * 40 + STATUS_COL, Status3
   449  c2bb 60                 	rts
   450                          PrintStatus4:
   451  c2bc a200bd3acbc9fff0...	+print SCREEN_RAM + STATUS_ROW * 40 + STATUS_COL, Status4
   452  c2cb 60                 	rts
   453                          PrintStatus5:
   454  c2cc a200bd50cbc9fff0...	+print SCREEN_RAM + STATUS_ROW * 40 + STATUS_COL, Status5
   455  c2db 60                 	rts
   456                          
   457                          ; Wait for the raster line in TARGET_LINE and return at the same cycle offset into that line on
   458                          ; every frame. Uses A; leaves X and Y alone.
   459                          SyncToLine:
   460  c2dc a5fecd12d0d0fbad...	+poll_and_read_clock            ; poll exits 0-6 cycles after the line began
   461  c2e6 8502               	sta FILLER                      ; 3   this frame's clock value
   462  c2e8 a5fd               	lda CALIB                       ; 3
   463  c2ea 38                 	sec                             ; 2
   464  c2eb e502               	sbc FILLER                      ; 3   reference minus this frame: negative if this frame is late
   465  c2ed 18                 	clc                             ; 2
   466  c2ee 6909               	adc #SLIDE_CENTER               ; 2   later frame => larger entry => shorter delay
   467  c2f0 290f               	and #15                         ; 2   a jump into the slide even if the poll ever missed a frame
   468  c2f2 8df6c2             	sta SyncSlideJmp + 1            ; 4
   469                          SyncSlideJmp:
   470  c2f5 4c00c3             	jmp SyncSlide                   ; 3
   471  c2f8 eaeaeaeaeaeaeaea   	!align 255, 0
   472                          SyncSlide:
   473                          	; Entered at offset k (0-17) this takes 19 - k cycles: pairs of $C9 are CMP #$C9 (2 cycles);
   474                          	; the tail is either CMP $EA (3 cycles) or CMP #$C5 + NOP (4 cycles) depending on parity.
   475  c300 c9c9c9c9c9c9c9c9...	!byte $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c5, $ea
   476  c312 60                 	rts
   477                          
   478                          ;------------------------------------------------------------
   479                          ;Raster interrupt, entered in the top border on line 40
   480                          ;------------------------------------------------------------
   481                          
   482                          Irq:
   483  c313 a91b               	lda #D011_DEN_ON
   484  c315 8504               	sta CONTROL_AFTER    ; phases 1-4: the loop leaves $d011 as it is
   485  c317 a5f9               	lda PHASE
   486  c319 f044               	beq Phase1
   487  c31b c901               	cmp #1
   488  c31d f02f               	beq Phase2
   489  c31f c902               	cmp #2
   490  c321 f015               	beq Phase3
   491  c323 c903               	cmp #3
   492  c325 f007               	beq Phase4
   493                          
   494                          	; Phase 5: as phase 3, but the loop ends by selecting 24 rows on line 250, so line 251 is no
   495                          	; longer the bottom compare line and the border flip-flop is never set; ColumnsDone restores
   496                          	; 25 rows on line 253, after which no compare line is left in the frame.
   497  c327 a913               	lda #D011_ROWS_24
   498  c329 8504               	sta CONTROL_AFTER
   499  c32b 4c38c3             	jmp Phase3
   500                          
   501                          Phase4:
   502                          	; DEN off for the whole frame; the border never opens, so the columns go to $d020.
   503  c32e a90b               	lda #D011_DEN_OFF
   504  c330 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   505  c333 a202               	ldx #2
   506  c335 4c61c3             	jmp RunColumns
   507                          
   508                          Phase3:
   509                          	; DEN off through line 48, on again on line 49: no bad lines, border open, idle graphics.
   510  c338 a90b               	lda #D011_DEN_OFF
   511  c33a 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   512  c33d a931cd12d0d0fb     	+wait_line DEN_SAMPLE_LINE + 1
   513  c344 a91b               	lda #D011_DEN_ON
   514  c346 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   515  c349 a200               	ldx #0
   516  c34b 4c61c3             	jmp RunColumns
   517                          
   518                          Phase2:
   519                          	; DEN off from line 40, set again a few cycles into line 48: the VIC-II sees it during the
   520                          	; line, so this frame displays normally, bad lines included.
   521  c34e a90b               	lda #D011_DEN_OFF
   522  c350 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   523  c353 a930cd12d0d0fb     	+wait_line DEN_SAMPLE_LINE
   524  c35a a91b               	lda #D011_DEN_ON
   525  c35c 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   526                          Phase1:
   527  c35f a200               	ldx #0
   528                          
   529                          ; X = 0 for background columns, 2 for border columns. Picks the loop for the model, syncs to
   530                          ; line 50 and enters it; the loop is written for the return to land a fixed number of cycles
   531                          ; before the first idle byte write.
   532                          RunColumns:
   533  c361 a5fb               	lda IS_PAL
   534  c363 f004               	beq +
   535  c365 e8                 	inx
   536  c366 e8                 	inx
   537  c367 e8                 	inx
   538  c368 e8                 	inx
   539  c369 bdc0c3             +	lda EntryTable,x
   540  c36c 85f7               	sta ENTRY
   541  c36e bdc1c3             	lda EntryTable + 1,x
   542  c371 85f8               	sta ENTRY + 1
   543  c373 a932               	lda #SYNC_LINE
   544  c375 85fe               	sta TARGET_LINE
   545  c377 20dcc2             	jsr SyncToLine                  ; returns 44-50 cycles into line 50
   546  c37a a200               	ldx #0                          ; 2
   547  c37c 6cf700             	jmp (ENTRY)                     ; 5
   548                          
   549                          ColumnsDone:
   550  c37f a5f9               	lda PHASE
   551  c381 c904               	cmp #4
   552  c383 d00c               	bne Tail
   553  c385 a9fdcd12d0d0fb     	+wait_line ROWS_25_AGAIN_LINE   ; phase 5: 25 rows again, once line 251 has passed
   554  c38c a91b               	lda #D011_DEN_ON
   555  c38e 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   556                          
   557                          Tail:
   558  c391 a5f9               	lda PHASE
   559  c393 d00a               	bne Counting
   560  c395 a503               	lda START            ; phase 1 stays until the main loop has seen the space bar
   561  c397 f021               	beq Done
   562  c399 a900               	lda #0
   563  c39b 8503               	sta START
   564  c39d f008               	beq Advance
   565                          Counting:
   566  c39f e6fa               	inc FRAME
   567  c3a1 a5fa               	lda FRAME
   568  c3a3 c964               	cmp #PHASE_FRAMES
   569  c3a5 d013               	bne Done
   570                          Advance:
   571  c3a7 a900               	lda #0
   572  c3a9 85fa               	sta FRAME
   573  c3ab e6f9               	inc PHASE
   574  c3ad a5f9               	lda PHASE
   575  c3af c905               	cmp #PHASES
   576  c3b1 d004               	bne +
   577  c3b3 a900               	lda #0
   578  c3b5 85f9               	sta PHASE
   579  c3b7 207ac2             +	jsr PrintStatus
   580                          Done:
   581  c3ba 0e19d0             	asl $d019            ; acknowledge the interrupt by clearing the VIC's interrupt flag
   582  c3bd 4c81ea             	jmp $ea81            ; jump into shorter ROM routine to only restore registers from the stack etc
   583                          
   584                          EntryTable:
   585  c3c0 00c580c5           	!word NtscBackgroundColumns, NtscBorderColumns
   586  c3c4 00c480c4           	!word PalBackgroundColumns, PalBorderColumns
   587                          
   588  c3c8 eaeaeaeaeaeaeaea...	+column_loop SCREEN_BACKGROUND_COLOR_ADDRESS, CYCLES_PER_LINE_PAL - LOOP_CYCLES, ~PalBackgroundColumns
   589  c445 eaeaeaeaeaeaeaea...	+column_loop SCREEN_BORDER_COLOR_ADDRESS, CYCLES_PER_LINE_PAL - LOOP_CYCLES, ~PalBorderColumns
   590  c4c5 eaeaeaeaeaeaeaea...	+column_loop SCREEN_BACKGROUND_COLOR_ADDRESS, CYCLES_PER_LINE_NTSC - LOOP_CYCLES, ~NtscBackgroundColumns
   591  c546 eaeaeaeaeaeaeaea...	+column_loop SCREEN_BORDER_COLOR_ADDRESS, CYCLES_PER_LINE_NTSC - LOOP_CYCLES, ~NtscBorderColumns
   592                          
   593                          ;------------------------------------------------------------
   594                          ;Tables
   595                          ;------------------------------------------------------------
   596                          
   597                          ; A 24x21 ball, the shape of all eight sprites.
   598                          SpriteShape:
   599  c5c6 007e00             	!byte %00000000, %01111110, %00000000
   600  c5c9 01ff80             	!byte %00000001, %11111111, %10000000
   601  c5cc 03ffc0             	!byte %00000011, %11111111, %11000000
   602  c5cf 07ffe0             	!byte %00000111, %11111111, %11100000
   603  c5d2 0ffff0             	!byte %00001111, %11111111, %11110000
   604  c5d5 1ffff8             	!byte %00011111, %11111111, %11111000
   605  c5d8 1ffff8             	!byte %00011111, %11111111, %11111000
   606  c5db 3ffffc             	!byte %00111111, %11111111, %11111100
   607  c5de 3ffffc             	!byte %00111111, %11111111, %11111100
   608  c5e1 3ffffc             	!byte %00111111, %11111111, %11111100
   609  c5e4 3ffffc             	!byte %00111111, %11111111, %11111100
   610  c5e7 3ffffc             	!byte %00111111, %11111111, %11111100
   611  c5ea 3ffffc             	!byte %00111111, %11111111, %11111100
   612  c5ed 3ffffc             	!byte %00111111, %11111111, %11111100
   613  c5f0 1ffff8             	!byte %00011111, %11111111, %11111000
   614  c5f3 1ffff8             	!byte %00011111, %11111111, %11111000
   615  c5f6 0ffff0             	!byte %00001111, %11111111, %11110000
   616  c5f9 07ffe0             	!byte %00000111, %11111111, %11100000
   617  c5fc 03ffc0             	!byte %00000011, %11111111, %11000000
   618  c5ff 01ff80             	!byte %00000001, %11111111, %10000000
   619  c602 007e00             	!byte %00000000, %01111110, %00000000
   620                          
   621                          SpriteColours:
   622  c605 01070d030e0a0f08   	!byte 1, 7, 13, 3, 14, 10, 15, 8
   623                          
   624                          ; Sprite X positions: four across the window's width, the same four for the bottom row. The
   625                          ; fourth of each row sits at 292, which needs the X MSB bit (sprites 3 and 7 in $d010).
   626                          SpriteX:
   627  c60d 3484d4243484d424   	!byte 52, 132, 212, 292 - 256, 52, 132, 212, 292 - 256
   628                          
   629                          ; One idle byte per display line: 25 groups of 8 glyph rows. Page aligned so that the indexed
   630                          ; read in the loop never crosses a page and costs an extra cycle.
   631  c615 eaeaeaeaeaeaeaea...	!align 255, 0
   632                          IdleBytes:
   633                          	!for .group, 1, 5 {
   634                          		+heart
   635                          		+smiley
   636                          		+diamond
   637                          		+arrow
   638                          		+cross
   639  c700 0066ffff7e3c1800...	}
   640                          
   641                          ;------------------------------------------------------------
   642                          ;Text (screen codes, $ff terminated; lowercase source shows as uppercase)
   643                          ;------------------------------------------------------------
   644                          
   645  c7c8 1609032d09092004...Text0:	!scr "vic-ii display enable (den) test", $ff
   646  c7e9 04050e2028020914...Text2:	!scr "den (bit 4 of $d011) is sampled once", $ff
   647  c80e 100512200612010d...Text3:	!scr "per frame, during raster line 48. it", $ff
   648  c833 0405030904051320...Text4:	!scr "decides if the frame has bad lines and", $ff
   649  c85a 0c05141320140805...Text5:	!scr "lets the border open at line 51.", $ff
   650  c87b 0516051219201008...Text7:	!scr "every phase runs the same cycle-counted", $ff
   651  c8a3 0c0f0f10200f1605...Text8:	!scr "loop over the 200 screen lines: eight", $ff
   652  c8c9 0201030b07120f15...Text9:	!scr "background colours per line = columns.", $ff
   653  c8f0 312e2004050e2013...Text11:	!scr "1. den set all frame: every 8th line is", $ff
   654  c918 2020200120020104...Text12:	!scr "   a bad line that halts the cpu for 40", $ff
   655  c940 2020200319030c05...Text13:	!scr "   cycles, so the columns shear.", $ff
   656  c961 322e2004050e2003...Text14:	!scr "2. den cleared on line 40, set again", $ff
   657  c986 202020090e130904...Text15:	!scr "   inside line 48: counts, still shears", $ff
   658  c9ae 332e2004050e2003...Text16:	!scr "3. den cleared until line 49: no bad", $ff
   659  c9d3 2020200c090e0513...Text17:	!scr "   lines, straight columns. no rows are", $ff
   660  c9fb 2020200605140308...Text18:	!scr "   fetched: the black glyph is the byte", $ff
   661  ca23 2020200114202433...Text19:	!scr "   at $3fff, written once per line.", $ff
   662  ca47 342e2004050e2003...Text20:	!scr "4. den cleared all frame: border only.", $ff
   663  ca6e 352e20011320332c...Text21:	!scr "5. as 3, but 24 rows during line 251:", $ff
   664  ca94 2020201408052002...Text22:	!scr "   the border never closes and 8 sprites", $ff
   665  cabd 20202013080f1720...Text23:	!scr "   show in the top and bottom borders.", $ff
   666  cae4 13100103053d1215...Text24:	!scr "space=run 2-5. now:", $ff
   667                          
   668  caf8 312004050e200f0e...Status1:	!scr "1 den on, shear      ", $ff
   669  cb0e 322004050e200f0e...Status2:	!scr "2 den on in line 48  ", $ff
   670  cb24 332004050e200f06...Status3:	!scr "3 den off, idle      ", $ff
   671  cb3a 342004050e200f06...Status4:	!scr "4 den off all frame  ", $ff
   672  cb50 3520020f12040512...Status5:	!scr "5 border open        ", $ff
