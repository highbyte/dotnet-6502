
; ******** Source: raster_columns.asm
     1                          ;ACME assembler
     2                          ;!to "./raster_columns.prg"
     3                          
     4                          ; VIC-II colour columns: how finely the border colour can be changed along a raster line.
     5                          ;
     6                          ; The VIC-II applies a write to $D020 from the cycle the write lands on, so the picture has
     7                          ; 8-pixel (one cycle) granularity. What limits a program is the CPU: the fastest 6502 store to
     8                          ; an absolute address takes 4 cycles, so the highest column resolution is
     9                          ;
    10                          ;   4 cycles = 32 pixels = 4 character cells, using STA/STX/STY back to back.
    11                          ;
    12                          ; That rate needs the colours already in A, X and Y, so at most three colours repeat. Loading a
    13                          ; new colour costs 2 cycles more, giving
    14                          ;
    15                          ;   6 cycles = 48 pixels = 6 character cells, with any colour per column.
    16                          ;
    17                          ; Two bands in the top border show both. Every line of a band runs the same store sequence and
    18                          ; takes exactly one raster line (63 cycles on PAL, 65 on NTSC; the model is detected at start), so
    19                          ; the colour changes land at the same position on every line and the columns are vertical. The
    20                          ; store sequence is written out for every line of a band rather than looped, because a loop's own
    21                          ; counter and branch would cost 8 cycles per line, a 64-pixel column of nothing. A raster line is
    22                          ; still not a whole number of columns, so one column per line is wider by the remainder: 3 cycles
    23                          ; on PAL, 5 on NTSC.
    24                          ;
    25                          ; The effect runs in the border to keep it simple. With the display on, one raster line in eight is
    26                          ; a bad line: the VIC-II takes the bus for about 40 cycles in the middle of it to fetch the video
    27                          ; matrix, and the CPU stops at its next opcode fetch. That window covers the whole visible part of
    28                          ; that one line, so it comes out in a single colour; the other seven lines are untouched and take
    29                          ; columns at the same rate as the border does. Keeping those seven lines in step across the stolen
    30                          ; cycles is the work, and screen_columns.asm does it. Above raster line 48 no bad line can occur,
    31                          ; whatever YSCROLL is, so the top border needs none of that.
    32                          ;
    33                          ; A raster interrupt alone is not accurate enough to place columns: it arrives a few cycles late
    34                          ; depending on the instruction it interrupts, and the raster line poll that follows is only
    35                          ; accurate to its 7-cycle loop, so the columns would jump sideways from frame to frame. CIA 1
    36                          ; timer A is therefore run as a free line clock (period = one raster line). At start the clock is
    37                          ; read at a known cycle of a raster line (see CalibrateLineClock), and every later poll's reading
    38                          ; then says how many cycles into the line the poll got out; a 1-cycle-resolution delay slide makes
    39                          ; up the difference, so the columns land on the same cycle every frame and, since the reference
    40                          ; does not depend on the cycle the program happened to be started on, on every run. That last point
    41                          ; is what makes the picture comparable with another emulator or a real machine.
    42                          
    43                          ;code start address
    44                          * = $c000
    45                          
    46                          ;------------------------------------------------------------
    47                          ;Program settings
    48                          ;------------------------------------------------------------
    49                          
    50                          SCREEN_CONTROL_REGISTER_1 = $d011
    51                          SCREEN_RASTER_LINE = $d012
    52                          SCREEN_BORDER_COLOR_ADDRESS = $d020
    53                          SCREEN_BACKGROUND_COLOR_ADDRESS = $d021
    54                          
    55                          CIA1_TIMER_A_LO = $dc04
    56                          CIA1_TIMER_A_HI = $dc05
    57                          CIA1_CONTROL_A = $dc0e
    58                          
    59                          SCREEN_RAM = $0400
    60                          COLOR_RAM = $d800
    61                          
    62                          IS_PAL = $fb            ; zero page: 1 on PAL, 0 on NTSC
    63                          LAST_LINE_LO = $fc      ; zero page: scratch for the model detection
    64                          CALIB = $fd             ; zero page: line clock value 9 cycles into a raster line (see CalibrateLineClock)
    65                          TARGET_LINE = $fe       ; zero page: raster line SyncToLine waits for
    66                          FILLER = $02            ; zero page: scratch, also the byte the timing filler reads
    67                          LINE_CYCLES = $03       ; zero page: 63 on PAL, 65 on NTSC
    68                          
    69                          ; Lines the calibration polls: in the top border, above any bad line and with no sprite on them.
    70                          CALIB_FIRST_LINE = 10
    71                          CALIB_LINES = 16
    72                          
    73                          ; Both bands sit below raster line 50, where no bad line can occur with the default YSCROLL of 3,
    74                          ; and inside the part of the top border that both models actually show: PAL's visible top border
    75                          ; starts at raster line 9 but NTSC's only at 34.
    76                          ; A band starts partway into its first line and so ends partway into the line after its last, which
    77                          ; is why the second band's first line is two lines after the first band's last: its wait would
    78                          ; otherwise be for a line that has just gone by, and would sit out a whole frame.
    79                          BAND_A_LINE = 34        ; first raster line of the 4-cycle band
    80                          BAND_A_LINES = 7
    81                          BAND_B_LINE = 43        ; first raster line of the 6-cycle band
    82                          BAND_B_LINES = 7
    83                          
    84                          CYCLES_PER_LINE_PAL = 63
    85                          CYCLES_PER_LINE_NTSC = 65
    86                          
    87                          BAND_A_COLUMNS = 15     ; 15 * 4 = 60 cycles of columns
    88                          BAND_B_COLUMNS = 10     ; 10 * 6 = 60 cycles of columns
    89                          
    90                          ; Slide entry for a poll that got out of its loop as early as possible. SyncToLine's poll loop is
    91                          ; 7 cycles, so a poll gets out 0-6 cycles later than that and the entry stays within 9-15.
    92                          SLIDE_CENTER = 9
    93                          ; The slide entry table covers timer differences this far either side of the expected one.
    94                          SLIDE_RANGE = 8
    95                          
    96                          COLOR_BLACK = 0
    97                          COLOR_WHITE = 1
    98                          
    99                          ;------------------------------------------------------------
   100                          ;Macros
   101                          ;------------------------------------------------------------
   102                          
   103                          ; Burn .cycles cycles (>= 2). NOPs in pairs, with a 3-cycle BIT for an odd count.
   104                          !macro delay_cycles .cycles {
   105                          	!if .cycles & 1 {
   106                          		bit FILLER
   107                          		!fill (.cycles - 3) / 2, $ea
   108                          	} else {
   109                          		!fill .cycles / 2, $ea
   110                          	}
   111                          }
   112                          
   113                          ; Wait for the raster line in TARGET_LINE, then read the line clock, always 3 cycles after the
   114                          ; poll got out of its loop, so the reading says when that was.
   115                          !macro poll_and_read_clock {
   116                          	lda TARGET_LINE                 ; 3
   117                          -	cmp SCREEN_RASTER_LINE          ; 4
   118                          	bne -                           ; 3 taken / 2 falling through
   119                          	lda CIA1_TIMER_A_LO             ; 4   (the read lands on the 4th cycle)
   120                          }
   121                          
   122                          ; Copy a $ff-terminated screen-code string to screen memory.
   123                          !macro print .screenaddr, .text {
   124                          	ldx #0
   125                          -	lda .text,x
   126                          	cmp #$ff
   127                          	beq +
   128                          	sta .screenaddr,x
   129                          	inx
   130                          	bne -
   131                          +
   132                          }
   133                          
   134                          ; The 4-cycle band, written out line by line: 15 stores from the three preloaded colour registers,
   135                          ; then the remainder of the raster line. 15 is a multiple of 3, so every line starts on the same
   136                          ; colour and the columns line up vertically.
   137                          !macro band_a .fill, .lines, ~.entry {
   138                          .Start:
   139                          	!for .line, 1, .lines {
   140                          		!for .group, 1, BAND_A_COLUMNS / 3 {
   141                          			sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   142                          			stx SCREEN_BORDER_COLOR_ADDRESS     ; 4
   143                          			sty SCREEN_BORDER_COLOR_ADDRESS     ; 4
   144                          		}
   145                          		+delay_cycles .fill
   146                          	}
   147                          	.entry = .Start
   148                          }
   149                          
   150                          ; One line of the 6-cycle band: 10 columns, each loading its own colour first.
   151                          !macro band_b_line {
   152                          	lda #2                              ; 2   red
   153                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   154                          	lda #8                              ; 2   orange
   155                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   156                          	lda #7                              ; 2   yellow
   157                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   158                          	lda #5                              ; 2   green
   159                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   160                          	lda #13                             ; 2   light green
   161                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   162                          	lda #3                              ; 2   cyan
   163                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   164                          	lda #14                             ; 2   light blue
   165                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   166                          	lda #6                              ; 2   blue
   167                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   168                          	lda #4                              ; 2   purple
   169                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   170                          	lda #1                              ; 2   white
   171                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   172                          }
   173                          
   174                          ; The 6-cycle band, written out line by line.
   175                          !macro band_b .fill, .lines, ~.entry {
   176                          .Start:
   177                          	!for .line, 1, .lines {
   178                          		+band_b_line
   179                          		+delay_cycles .fill
   180                          	}
   181                          	.entry = .Start
   182                          }
   183                          
   184                          ;------------------------------------------------------------
   185                          ;Code start
   186                          ;------------------------------------------------------------
   187                          
   188                          Init:
   189  c000 78                 	sei                  ; set interrupt bit, make the CPU ignore interrupt requests
   190  c001 a97f               	lda #%01111111       ; switch off interrupt signals from CIA-1
   191  c003 8d0ddc             	sta $dc0d
   192                          
   193  c006 2d11d0             	and SCREEN_CONTROL_REGISTER_1 ; clear most significant bit of VIC's raster register
   194  c009 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   195                          
   196  c00c ad0ddc             	lda $dc0d            ; acknowledge pending interrupts from CIA-1
   197  c00f ad0ddd             	lda $dd0d            ; acknowledge pending interrupts from CIA-2
   198                          
   199  c012 205bc0             	jsr DetectModel
   200                          
   201  c015 a900               	lda #COLOR_BLACK
   202  c017 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   203  c01a 8d21d0             	sta SCREEN_BACKGROUND_COLOR_ADDRESS
   204  c01d 202cc1             	jsr ClearScreen
   205  c020 2051c1             	jsr DrawScreen
   206                          
   207                          	; Line clock: timer A counts one raster line per period (latch + 1 cycles), continuously.
   208  c023 a900               	lda #0
   209  c025 8d05dc             	sta CIA1_TIMER_A_HI
   210  c028 a940               	lda #CYCLES_PER_LINE_NTSC - 1
   211  c02a a6fb               	ldx IS_PAL
   212  c02c f002               	beq +
   213  c02e a93e               	lda #CYCLES_PER_LINE_PAL - 1
   214  c030 8d04dc             +	sta CIA1_TIMER_A_LO
   215                          
   216                          !ifdef TSHIFT {
   217                          	!fill TSHIFT, $ea    ; test builds: shift the timer's phase against the raster line
   218                          }
   219  c033 a911               	lda #%00010001       ; force load + start, continuous
   220  c035 8d0edc             	sta CIA1_CONTROL_A
   221                          
   222  c038 2087c0             	jsr CalibrateLineClock
   223  c03b 20fbc0             	jsr BuildSlideEntryTable
   224                          
   225                          	; Raster IRQ two lines above the first band: interrupt latency and the KERNAL's interrupt
   226                          	; entry take more than one raster line, and the handler must reach its poll in time.
   227  c03e a920               	lda #BAND_A_LINE - 2
   228  c040 8d12d0             	sta SCREEN_RASTER_LINE
   229  c043 a913               	lda #<Irq
   230  c045 8d1403             	sta $0314
   231  c048 a9c4               	lda #>Irq
   232  c04a 8d1503             	sta $0315
   233                          
   234  c04d a90f               	lda #%00001111       ; clear any pending VIC interrupt flag
   235  c04f 8d19d0             	sta $d019
   236  c052 a901               	lda #%00000001       ; enable raster interrupt signals from VIC
   237  c054 8d1ad0             	sta $d01a
   238                          
   239  c057 58                 	cli                  ; clear interrupt flag, allowing the CPU to respond to interrupt requests
   240  c058 4c58c0             	jmp *
   241                          
   242                          ; PAL or NTSC: after the raster passes line 255, remember the last low byte seen before it wraps
   243                          ; to 0. NTSC wraps after line 262 (low byte 6), PAL after line 311 (low byte 55).
   244                          DetectModel:
   245  c05b a900               	lda #0
   246  c05d 85fc               	sta LAST_LINE_LO
   247  c05f 2c11d0             -	bit SCREEN_CONTROL_REGISTER_1
   248  c062 10fb               	bpl -
   249                          	; Keep the highest line low byte seen while bit 8 is set, rather than the last one: the raster
   250                          	; can wrap to 0 between reading the line and testing bit 8, and the last value would then be 0
   251                          	; on either model. That misread makes the effect use the wrong line length on PAL.
   252  c064 ad12d0             -	lda SCREEN_RASTER_LINE
   253  c067 c5fc               	cmp LAST_LINE_LO
   254  c069 9002               	bcc +
   255  c06b 85fc               	sta LAST_LINE_LO
   256  c06d 2c11d0             +	bit SCREEN_CONTROL_REGISTER_1
   257  c070 30f2               	bmi -
   258  c072 a900               	lda #0
   259  c074 85fb               	sta IS_PAL
   260  c076 a941               	lda #CYCLES_PER_LINE_NTSC
   261  c078 8503               	sta LINE_CYCLES
   262  c07a a5fc               	lda LAST_LINE_LO
   263  c07c c920               	cmp #$20
   264  c07e 9006               	bcc +
   265  c080 e6fb               	inc IS_PAL
   266  c082 a93f               	lda #CYCLES_PER_LINE_PAL
   267  c084 8503               	sta LINE_CYCLES
   268  c086 60                 +	rts
   269                          
   270                          ; Read the line clock at a fixed cycle of a raster line, whatever cycle this program was started
   271                          ; on. A poll loop can only get out of its loop a whole loop length after the line began, and where
   272                          ; in the loop the line change falls depends on the start cycle. This loop is 11 cycles, which
   273                          ; neither 63 nor 65 is a multiple of, so its position drifts by 8 (PAL) or 10 (NTSC) cycles per
   274                          ; line (7 on PAL, 5 on NTSC, counting the work between two lines' polls) and within 11 lines
   275                          ; every position has come up once, including the earliest: the poll that got out 6 cycles into
   276                          ; the line, whose timer read (the 4th cycle of the LDA, so 9 cycles in) gives the largest value,
   277                          ; since the timer counts down. That value is the reference.
   278                          CalibrateLineClock:
   279  c087 a90a               	lda #CALIB_FIRST_LINE
   280  c089 85fe               	sta TARGET_LINE
   281  c08b a200               	ldx #0
   282  c08d a5fe               -	lda TARGET_LINE                 ; 3
   283  c08f cd12d0             --	cmp SCREEN_RASTER_LINE          ; 4   (the read lands on the 4th cycle)
   284  c092 ea                 	nop                             ; 2
   285  c093 ea                 	nop                             ; 2
   286  c094 d0f9               	bne --                          ; 3 taken / 2 falling through
   287  c096 ad04dc             	lda CIA1_TIMER_A_LO             ; 4   (the read lands on the 4th cycle)
   288  c099 9deac0             	sta CalibReadings,x             ; 5   every reading is kept, so the work between two lines'
   289  c09c e8                 	inx                             ; 2   polls is always the same and the loop's position drifts
   290  c09d e6fe               	inc TARGET_LINE                 ; 5   by the same amount each line (7 on PAL, 5 on NTSC)
   291  c09f a5fe               	lda TARGET_LINE                 ; 3
   292  c0a1 c91a               	cmp #CALIB_FIRST_LINE + CALIB_LINES ; 2
   293  c0a3 d0e8               	bne -                           ; 3
   294                          	; The reading from the earliest exit is the largest, the others lie within 10 below it. If the
   295                          	; readings straddle the timer's reload, the ones from the later exits have wrapped to the top
   296                          	; of the period and the earliest is then the largest of those below 11.
   297  c0a5 a9ff               	lda #255
   298  c0a7 8502               	sta FILLER
   299  c0a9 20bfc0             	jsr LargestCalibReading
   300  c0ac 85fd               	sta CALIB
   301  c0ae 38                 	sec
   302  c0af e502               	sbc FILLER                      ; largest minus smallest
   303  c0b1 c90b               	cmp #11
   304  c0b3 9009               	bcc +
   305  c0b5 a90b               	lda #11
   306  c0b7 8502               	sta FILLER                      ; only readings below 11 count
   307  c0b9 20bfc0             	jsr LargestCalibReading
   308  c0bc 85fd               	sta CALIB
   309  c0be 60                 +	rts
   310                          
   311                          ; A = the largest reading below FILLER's value on entry (FILLER = 255 for all of them); FILLER
   312                          ; leaves with the smallest reading.
   313                          LargestCalibReading:
   314  c0bf a20f               	ldx #CALIB_LINES - 1
   315  c0c1 a900               	lda #0
   316  c0c3 85fe               	sta TARGET_LINE                 ; largest so far
   317  c0c5 a9ff               	lda #255
   318  c0c7 8dfac0             	sta LINE_CYCLES_SAVE            ; smallest so far
   319  c0ca bdeac0             -	lda CalibReadings,x
   320  c0cd c502               	cmp FILLER
   321  c0cf b00e               	bcs +                           ; at or above the limit: skip
   322  c0d1 c5fe               	cmp TARGET_LINE
   323  c0d3 9002               	bcc ++
   324  c0d5 85fe               	sta TARGET_LINE
   325  c0d7 cdfac0             ++	cmp LINE_CYCLES_SAVE
   326  c0da b003               	bcs +
   327  c0dc 8dfac0             	sta LINE_CYCLES_SAVE
   328  c0df ca                 +	dex
   329  c0e0 10e8               	bpl -
   330  c0e2 adfac0             	lda LINE_CYCLES_SAVE
   331  c0e5 8502               	sta FILLER
   332  c0e7 a5fe               	lda TARGET_LINE
   333  c0e9 60                 	rts
   334                          CalibReadings:
   335  c0ea 0000000000000000...	!fill CALIB_LINES, 0
   336                          LINE_CYCLES_SAVE:
   337  c0fa 00                 	!byte 0
   338                          
   339                          ; The slide entry for every possible timer difference (reference minus this poll's reading), so
   340                          ; SyncToLine needs no arithmetic that could branch or wrap. SyncToLine's poll gets out 2-8 cycles
   341                          ; into the line and reads the timer 3 cycles later, 5-11 cycles in against the reference's 9, so
   342                          ; the difference is -4 to +2 for a poll that made it, and the entry is SLIDE_CENTER plus that. The
   343                          ; difference can also come out a line period off, when the two readings straddle the timer's
   344                          ; reload: those entries are filled the same way. Everything else gets the nominal entry.
   345                          BuildSlideEntryTable:
   346  c0fb a200               	ldx #0
   347  c0fd a909               	lda #SLIDE_CENTER
   348  c0ff 9d00c3             -	sta SlideEntryTable,x
   349  c102 e8                 	inx
   350  c103 d0fa               	bne -
   351  c105 a2f8               	ldx #<-SLIDE_RANGE              ; difference, as a byte
   352  c107 a901               	lda #SLIDE_CENTER - SLIDE_RANGE ; its entry
   353  c109 8502               	sta FILLER
   354  c10b a502               -	lda FILLER
   355  c10d 9d00c3             	sta SlideEntryTable,x           ; difference as it is
   356  c110 8a                 	txa
   357  c111 18                 	clc
   358  c112 6503               	adc LINE_CYCLES
   359  c114 a8                 	tay
   360  c115 a502               	lda FILLER
   361  c117 9900c3             	sta SlideEntryTable,y           ; difference plus a period
   362  c11a 8a                 	txa
   363  c11b 38                 	sec
   364  c11c e503               	sbc LINE_CYCLES
   365  c11e a8                 	tay
   366  c11f a502               	lda FILLER
   367  c121 9900c3             	sta SlideEntryTable,y           ; difference minus a period
   368  c124 e602               	inc FILLER
   369  c126 e8                 	inx
   370  c127 e009               	cpx #SLIDE_RANGE + 1
   371  c129 d0e0               	bne -
   372  c12b 60                 	rts
   373                          
   374                          ClearScreen:
   375  c12c a200               	ldx #0
   376  c12e a920               	lda #$20
   377  c130 9d0004             -	sta SCREEN_RAM,x
   378  c133 9d0005             	sta SCREEN_RAM + $100,x
   379  c136 9d0006             	sta SCREEN_RAM + $200,x
   380  c139 9d0007             	sta SCREEN_RAM + $300,x
   381  c13c e8                 	inx
   382  c13d d0f1               	bne -
   383  c13f a901               	lda #COLOR_WHITE
   384  c141 9d00d8             -	sta COLOR_RAM,x
   385  c144 9d00d9             	sta COLOR_RAM + $100,x
   386  c147 9d00da             	sta COLOR_RAM + $200,x
   387  c14a 9d00db             	sta COLOR_RAM + $300,x
   388  c14d e8                 	inx
   389  c14e d0f1               	bne -
   390  c150 60                 	rts
   391                          
   392                          DrawScreen:
   393  c151 a200bdd1c9c9fff0...	+print SCREEN_RAM + 1 * 40, Text0
   394  c160 a200bde7c9c9fff0...	+print SCREEN_RAM + 3 * 40, Text1
   395  c16f a200bd0dcac9fff0...	+print SCREEN_RAM + 4 * 40, Text2
   396  c17e a200bd35cac9fff0...	+print SCREEN_RAM + 5 * 40, Text3
   397  c18d a200bd5dcac9fff0...	+print SCREEN_RAM + 7 * 40, Text4
   398  c19c a200bd85cac9fff0...	+print SCREEN_RAM + 8 * 40, Text5
   399  c1ab a200bdaacac9fff0...	+print SCREEN_RAM + 10 * 40, Text6
   400  c1ba a200bdcfcac9fff0...	+print SCREEN_RAM + 11 * 40, Text7
   401  c1c9 a200bdf1cac9fff0...	+print SCREEN_RAM + 12 * 40, Text8
   402  c1d8 a200bd16cbc9fff0...	+print SCREEN_RAM + 14 * 40, Text9
   403  c1e7 a200bd38cbc9fff0...	+print SCREEN_RAM + 15 * 40, Text10
   404  c1f6 a200bd5fcbc9fff0...	+print SCREEN_RAM + 16 * 40, Text11
   405  c205 60                 	rts
   406                          
   407                          ; Wait for the raster line in TARGET_LINE and return 46 cycles into it, on every frame and on
   408                          ; every run. Uses A; leaves X and Y alone so a band can keep its colours in them.
   409                          SyncToLine:
   410  c206 a5fecd12d0d0fbad...	+poll_and_read_clock            ; poll exits 2-8 cycles after the line began
   411  c210 8502               	sta FILLER                      ; 3   this poll's clock value
   412  c212 a5fd               	lda CALIB                       ; 3
   413  c214 38                 	sec                             ; 2
   414  c215 e502               	sbc FILLER                      ; 3   reference minus this poll: larger the later the poll got out
   415  c217 aa                 	tax                             ; 2
   416  c218 bd00c3             	lda SlideEntryTable,x           ; 4   later poll => larger entry => shorter delay
   417  c21b 8d1fc2             	sta SyncSlideJmp + 1            ; 4
   418                          SyncSlideJmp:
   419  c21e 4c00c4             	jmp SyncSlide                   ; 3
   420  c221 eaeaeaeaeaeaeaea...	!align 255, 0
   421                          SlideEntryTable:
   422  c300 0000000000000000...	!fill 256, 0
   423                          SyncSlide:
   424                          	; Entered at offset k (0-17) this takes 19 - k cycles: pairs of $C9 are CMP #$C9 (2 cycles);
   425                          	; the tail is either CMP $EA (3 cycles) or CMP #$C5 + NOP (4 cycles) depending on parity.
   426  c400 c9c9c9c9c9c9c9c9...	!byte $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c5, $ea
   427  c412 60                 	rts
   428                          
   429                          ; Raster interrupt: draw both bands, then leave the border black for the rest of the frame.
   430                          Irq:
   431                          	; 4-cycle band: three colours held in A, X and Y. The model is selected through A only, so
   432                          	; the two colours in X and Y survive into the band.
   433  c413 a922               	lda #BAND_A_LINE
   434  c415 85fe               	sta TARGET_LINE
   435  c417 a202               	ldx #2                          ; red
   436  c419 a00e               	ldy #14                         ; light blue
   437  c41b 2006c2             	jsr SyncToLine
   438  c41e a5fb               	lda IS_PAL
   439  c420 f005               	beq +
   440  c422 a901               	lda #COLOR_WHITE
   441  c424 4c4dc4             	jmp PalBandA
   442  c427 a901               +	lda #COLOR_WHITE
   443  c429 4c99c5             	jmp NtscBandA
   444                          BandADone:
   445  c42c a900               	lda #COLOR_BLACK                ; blank the two lines between the bands
   446  c42e 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   447                          
   448                          	; 6-cycle band: a colour loaded per column.
   449  c431 a92b               	lda #BAND_B_LINE
   450  c433 85fe               	sta TARGET_LINE
   451  c435 2006c2             	jsr SyncToLine
   452  c438 a5fb               	lda IS_PAL
   453  c43a f003               	beq +
   454  c43c 4cecc6             	jmp PalBandB
   455  c43f 4c5bc8             +	jmp NtscBandB
   456                          BandBDone:
   457                          
   458  c442 a900               	lda #COLOR_BLACK
   459  c444 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   460  c447 0e19d0             	asl $d019            ; acknowledge the interrupt by clearing the VIC's interrupt flag
   461  c44a 4c81ea             	jmp $ea81            ; jump into shorter ROM routine to only restore registers from the stack etc
   462                          
   463  c44d 8d20d08e20d08c20...	+band_a CYCLES_PER_LINE_PAL - BAND_A_COLUMNS * 4, BAND_A_LINES, ~PalBandA
   464  c596 4c2cc4             	jmp BandADone
   465  c599 8d20d08e20d08c20...	+band_a CYCLES_PER_LINE_NTSC - BAND_A_COLUMNS * 4, BAND_A_LINES, ~NtscBandA
   466  c6e9 4c2cc4             	jmp BandADone
   467  c6ec a9028d20d0a9088d...	+band_b CYCLES_PER_LINE_PAL - BAND_B_COLUMNS * 6, BAND_B_LINES, ~PalBandB
   468  c858 4c42c4             	jmp BandBDone
   469  c85b a9028d20d0a9088d...	+band_b CYCLES_PER_LINE_NTSC - BAND_B_COLUMNS * 6, BAND_B_LINES, ~NtscBandB
   470  c9ce 4c42c4             	jmp BandBDone
   471                          
