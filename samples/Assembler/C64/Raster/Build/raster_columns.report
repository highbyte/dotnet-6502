   359  c7d1 1609032d09092003...Text0:	!scr "vic-ii colour columns", $ff
   360  c7e7 14080520020f1204...Text1:	!scr "the border colour takes effect at the", $ff
   361  c80d 0319030c05200914...Text2:	!scr "cycle it is written, 8 pixels wide. how", $ff
   362  c835 030c0f1305201408...Text3:	!scr "close the changes get is up to the cpu.", $ff
   363  c85d 1510100512200201...Text4:	!scr "upper band: sta/stx/sty $d020 in a row,", $ff
   364  c885 34200319030c0513...Text5:	!scr "4 cycles = 32 pixels, three colours.", $ff
   365  c8aa 0c0f170512200201...Text6:	!scr "lower band: lda #col then sta $d020,", $ff
   366  c8cf 36200319030c0513...Text7:	!scr "6 cycles = 48 pixels, any colour.", $ff
   367  c8f1 0f0e0520030f0c15...Text8:	!scr "one column per line is wider: a line", $ff
   368  c916 0913200e0f142001...Text9:	!scr "is not a whole number of columns.", $ff
   369  c938 090e201408052002...Text10:	!scr "in the border: the vic-ii steals every", $ff
   370  c95f 381408200c090e05...Text11:	!scr "8th line's middle while display is on.", $ff
