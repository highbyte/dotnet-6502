
; ******** Source: raster_columns.asm
     1                          ;ACME assembler
     2                          ;!to "./raster_columns.prg"
     3                          
     4                          ; VIC-II colour columns: how finely the border colour can be changed along a raster line.
     5                          ;
     6                          ; The VIC-II applies a write to $D020 from the cycle the write lands on, so the picture has
     7                          ; 8-pixel (one cycle) granularity. What limits a program is the CPU: the fastest 6502 store to
     8                          ; an absolute address takes 4 cycles, so the highest column resolution is
     9                          ;
    10                          ;   4 cycles = 32 pixels = 4 character cells, using STA/STX/STY back to back.
    11                          ;
    12                          ; That rate needs the colours already in A, X and Y, so at most three colours repeat. Loading a
    13                          ; new colour costs 2 cycles more, giving
    14                          ;
    15                          ;   6 cycles = 48 pixels = 6 character cells, with any colour per column.
    16                          ;
    17                          ; Two bands in the top border show both. Every line of a band runs the same store sequence and
    18                          ; takes exactly one raster line (63 cycles on PAL, 65 on NTSC; the model is detected at start), so
    19                          ; the colour changes land at the same position on every line and the columns are vertical. The
    20                          ; store sequence is written out for every line of a band rather than looped, because a loop's own
    21                          ; counter and branch would cost 8 cycles per line, a 64-pixel column of nothing. A raster line is
    22                          ; still not a whole number of columns, so one column per line is wider by the remainder: 3 cycles
    23                          ; on PAL, 5 on NTSC.
    24                          ;
    25                          ; The effect runs in the border to keep it simple. With the display on, one raster line in eight is
    26                          ; a bad line: the VIC-II takes the bus for about 40 cycles in the middle of it to fetch the video
    27                          ; matrix, and the CPU stops at its next opcode fetch. That window covers the whole visible part of
    28                          ; that one line, so it comes out in a single colour; the other seven lines are untouched and take
    29                          ; columns at the same rate as the border does. Keeping those seven lines in step across the stolen
    30                          ; cycles is the work, and screen_columns.asm does it. Above raster line 48 no bad line can occur,
    31                          ; whatever YSCROLL is, so the top border needs none of that.
    32                          ;
    33                          ; A raster interrupt alone is not accurate enough to place columns: it arrives a few cycles late
    34                          ; depending on the instruction it interrupts, and the raster line poll that follows is only
    35                          ; accurate to its 7-cycle loop, so the columns would jump sideways from frame to frame. CIA 1
    36                          ; timer A is therefore run as a free line clock (period = one raster line). At start the clock is
    37                          ; read at a known cycle of a raster line (see CalibrateLineClock), and every later poll's reading
    38                          ; then says how many cycles into the line the poll got out; a 1-cycle-resolution delay slide makes
    39                          ; up the difference, so the columns land on the same cycle every frame and, since the reference
    40                          ; does not depend on the cycle the program happened to be started on, on every run. That last point
    41                          ; is what makes the picture comparable with another emulator or a real machine.
    42                          
    43                          ;code start address
    44                          * = $c000
    45                          
    46                          ;------------------------------------------------------------
    47                          ;Program settings
    48                          ;------------------------------------------------------------
    49                          
    50                          SCREEN_CONTROL_REGISTER_1 = $d011
    51                          SCREEN_RASTER_LINE = $d012
    52                          SCREEN_BORDER_COLOR_ADDRESS = $d020
    53                          SCREEN_BACKGROUND_COLOR_ADDRESS = $d021
    54                          
    55                          CIA1_TIMER_A_LO = $dc04
    56                          CIA1_TIMER_A_HI = $dc05
    57                          CIA1_CONTROL_A = $dc0e
    58                          
    59                          SCREEN_RAM = $0400
    60                          COLOR_RAM = $d800
    61                          
    62                          IS_PAL = $fb            ; zero page: 1 on PAL, 0 on NTSC
    63                          LAST_LINE_LO = $fc      ; zero page: scratch for the model detection
    64                          CALIB = $fd             ; zero page: line clock value 9 cycles into a raster line (see CalibrateLineClock)
    65                          TARGET_LINE = $fe       ; zero page: raster line SyncToLine waits for
    66                          FILLER = $02            ; zero page: scratch, also the byte the timing filler reads
    67                          LINE_CYCLES = $03       ; zero page: 63 on PAL, 65 on NTSC
    68                          SAVE_X = $04            ; zero page: the caller's X across SyncToLine
    69                          
    70                          ; Lines the calibration polls: in the top border, above any bad line and with no sprite on them.
    71                          CALIB_FIRST_LINE = 10
    72                          CALIB_LINES = 16
    73                          
    74                          ; Both bands sit below raster line 50, where no bad line can occur with the default YSCROLL of 3,
    75                          ; and inside the part of the top border that both models actually show: PAL's visible top border
    76                          ; starts at raster line 9 but NTSC's only at 34.
    77                          ; A band starts partway into its first line and so ends partway into the line after its last, which
    78                          ; is why the second band's first line is two lines after the first band's last: its wait would
    79                          ; otherwise be for a line that has just gone by, and would sit out a whole frame.
    80                          BAND_A_LINE = 34        ; first raster line of the 4-cycle band
    81                          BAND_A_LINES = 7
    82                          BAND_B_LINE = 43        ; first raster line of the 6-cycle band
    83                          BAND_B_LINES = 7
    84                          
    85                          CYCLES_PER_LINE_PAL = 63
    86                          CYCLES_PER_LINE_NTSC = 65
    87                          
    88                          BAND_A_COLUMNS = 15     ; 15 * 4 = 60 cycles of columns
    89                          BAND_B_COLUMNS = 10     ; 10 * 6 = 60 cycles of columns
    90                          
    91                          ; Slide entry for a poll that got out of its loop 4 cycles later than the earliest possible.
    92                          ; SyncToLine's poll loop is 7 cycles, so the entry stays within 5-11.
    93                          SLIDE_CENTER = 9
    94                          ; The slide entry table covers timer differences this far either side of the expected one.
    95                          SLIDE_RANGE = 8
    96                          
    97                          COLOR_BLACK = 0
    98                          COLOR_WHITE = 1
    99                          
   100                          ;------------------------------------------------------------
   101                          ;Macros
   102                          ;------------------------------------------------------------
   103                          
   104                          ; Burn .cycles cycles (>= 2). NOPs in pairs, with a 3-cycle BIT for an odd count.
   105                          !macro delay_cycles .cycles {
   106                          	!if .cycles & 1 {
   107                          		bit FILLER
   108                          		!fill (.cycles - 3) / 2, $ea
   109                          	} else {
   110                          		!fill .cycles / 2, $ea
   111                          	}
   112                          }
   113                          
   114                          ; Wait for the raster line in TARGET_LINE, then read the line clock, always 3 cycles after the
   115                          ; poll got out of its loop, so the reading says when that was.
   116                          !macro poll_and_read_clock {
   117                          	lda TARGET_LINE                 ; 3
   118                          -	cmp SCREEN_RASTER_LINE          ; 4
   119                          	bne -                           ; 3 taken / 2 falling through
   120                          	lda CIA1_TIMER_A_LO             ; 4   (the read lands on the 4th cycle)
   121                          }
   122                          
   123                          ; Copy a $ff-terminated screen-code string to screen memory.
   124                          !macro print .screenaddr, .text {
   125                          	ldx #0
   126                          -	lda .text,x
   127                          	cmp #$ff
   128                          	beq +
   129                          	sta .screenaddr,x
   130                          	inx
   131                          	bne -
   132                          +
   133                          }
   134                          
   135                          ; The 4-cycle band, written out line by line: 15 stores from the three preloaded colour registers,
   136                          ; then the remainder of the raster line. 15 is a multiple of 3, so every line starts on the same
   137                          ; colour and the columns line up vertically.
   138                          !macro band_a .fill, .lines, ~.entry {
   139                          .Start:
   140                          	!for .line, 1, .lines {
   141                          		!for .group, 1, BAND_A_COLUMNS / 3 {
   142                          			sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   143                          			stx SCREEN_BORDER_COLOR_ADDRESS     ; 4
   144                          			sty SCREEN_BORDER_COLOR_ADDRESS     ; 4
   145                          		}
   146                          		+delay_cycles .fill
   147                          	}
   148                          	.entry = .Start
   149                          }
   150                          
   151                          ; One line of the 6-cycle band: 10 columns, each loading its own colour first.
   152                          !macro band_b_line {
   153                          	lda #2                              ; 2   red
   154                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   155                          	lda #8                              ; 2   orange
   156                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   157                          	lda #7                              ; 2   yellow
   158                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   159                          	lda #5                              ; 2   green
   160                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   161                          	lda #13                             ; 2   light green
   162                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   163                          	lda #3                              ; 2   cyan
   164                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   165                          	lda #14                             ; 2   light blue
   166                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   167                          	lda #6                              ; 2   blue
   168                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   169                          	lda #4                              ; 2   purple
   170                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   171                          	lda #1                              ; 2   white
   172                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   173                          }
   174                          
   175                          ; The 6-cycle band, written out line by line.
   176                          !macro band_b .fill, .lines, ~.entry {
   177                          .Start:
   178                          	!for .line, 1, .lines {
   179                          		+band_b_line
   180                          		+delay_cycles .fill
   181                          	}
   182                          	.entry = .Start
   183                          }
   184                          
   185                          ;------------------------------------------------------------
   186                          ;Code start
   187                          ;------------------------------------------------------------
   188                          
   189                          Init:
   190  c000 78                 	sei                  ; set interrupt bit, make the CPU ignore interrupt requests
   191  c001 a97f               	lda #%01111111       ; switch off interrupt signals from CIA-1
   192  c003 8d0ddc             	sta $dc0d
   193                          
   194  c006 2d11d0             	and SCREEN_CONTROL_REGISTER_1 ; clear most significant bit of VIC's raster register
   195  c009 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   196                          
   197  c00c ad0ddc             	lda $dc0d            ; acknowledge pending interrupts from CIA-1
   198  c00f ad0ddd             	lda $dd0d            ; acknowledge pending interrupts from CIA-2
   199                          
   200  c012 205bc0             	jsr DetectModel
   201                          
   202  c015 a900               	lda #COLOR_BLACK
   203  c017 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   204  c01a 8d21d0             	sta SCREEN_BACKGROUND_COLOR_ADDRESS
   205  c01d 202cc1             	jsr ClearScreen
   206  c020 2051c1             	jsr DrawScreen
   207                          
   208                          	; Line clock: timer A counts one raster line per period (latch + 1 cycles), continuously.
   209  c023 a900               	lda #0
   210  c025 8d05dc             	sta CIA1_TIMER_A_HI
   211  c028 a940               	lda #CYCLES_PER_LINE_NTSC - 1
   212  c02a a6fb               	ldx IS_PAL
   213  c02c f002               	beq +
   214  c02e a93e               	lda #CYCLES_PER_LINE_PAL - 1
   215  c030 8d04dc             +	sta CIA1_TIMER_A_LO
   216                          
   217                          !ifdef TSHIFT {
   218                          	!fill TSHIFT, $ea    ; test builds: shift the timer's phase against the raster line
   219                          }
   220  c033 a911               	lda #%00010001       ; force load + start, continuous
   221  c035 8d0edc             	sta CIA1_CONTROL_A
   222                          
   223  c038 2087c0             	jsr CalibrateLineClock
   224  c03b 20fbc0             	jsr BuildSlideEntryTable
   225                          
   226                          	; Raster IRQ two lines above the first band: interrupt latency and the KERNAL's interrupt
   227                          	; entry take more than one raster line, and the handler must reach its poll in time.
   228  c03e a920               	lda #BAND_A_LINE - 2
   229  c040 8d12d0             	sta SCREEN_RASTER_LINE
   230  c043 a915               	lda #<Irq
   231  c045 8d1403             	sta $0314
   232  c048 a9c4               	lda #>Irq
   233  c04a 8d1503             	sta $0315
   234                          
   235  c04d a90f               	lda #%00001111       ; clear any pending VIC interrupt flag
   236  c04f 8d19d0             	sta $d019
   237  c052 a901               	lda #%00000001       ; enable raster interrupt signals from VIC
   238  c054 8d1ad0             	sta $d01a
   239                          
   240  c057 58                 	cli                  ; clear interrupt flag, allowing the CPU to respond to interrupt requests
   241  c058 4c58c0             	jmp *
   242                          
   243                          ; PAL or NTSC: after the raster passes line 255, remember the last low byte seen before it wraps
   244                          ; to 0. NTSC wraps after line 262 (low byte 6), PAL after line 311 (low byte 55).
   245                          DetectModel:
   246  c05b a900               	lda #0
   247  c05d 85fc               	sta LAST_LINE_LO
   248  c05f 2c11d0             -	bit SCREEN_CONTROL_REGISTER_1
   249  c062 10fb               	bpl -
   250                          	; Keep the highest line low byte seen while bit 8 is set, rather than the last one: the raster
   251                          	; can wrap to 0 between reading the line and testing bit 8, and the last value would then be 0
   252                          	; on either model. That misread makes the effect use the wrong line length on PAL.
   253  c064 ad12d0             -	lda SCREEN_RASTER_LINE
   254  c067 c5fc               	cmp LAST_LINE_LO
   255  c069 9002               	bcc +
   256  c06b 85fc               	sta LAST_LINE_LO
   257  c06d 2c11d0             +	bit SCREEN_CONTROL_REGISTER_1
   258  c070 30f2               	bmi -
   259  c072 a900               	lda #0
   260  c074 85fb               	sta IS_PAL
   261  c076 a941               	lda #CYCLES_PER_LINE_NTSC
   262  c078 8503               	sta LINE_CYCLES
   263  c07a a5fc               	lda LAST_LINE_LO
   264  c07c c920               	cmp #$20
   265  c07e 9006               	bcc +
   266  c080 e6fb               	inc IS_PAL
   267  c082 a93f               	lda #CYCLES_PER_LINE_PAL
   268  c084 8503               	sta LINE_CYCLES
   269  c086 60                 +	rts
   270                          
   271                          ; Read the line clock at a fixed cycle of a raster line, whatever cycle this program was started
   272                          ; on. A poll loop can only get out of its loop a whole loop length after the line began, and where
   273                          ; in the loop the line change falls depends on the start cycle. This loop is 11 cycles, which
   274                          ; neither 63 nor 65 is a multiple of, so its position drifts by 8 (PAL) or 10 (NTSC) cycles per
   275                          ; line (7 on PAL, 5 on NTSC, counting the work between two lines' polls) and within 11 lines
   276                          ; every position has come up once, including the earliest: the poll whose compare read the new
   277                          ; line on its first cycle and so got out 7 cycles in, whose timer read (the 4th cycle of the LDA,
   278                          ; 10 cycles in) gives the largest value, since the timer counts down. That value is the reference.
   279                          CalibrateLineClock:
   280  c087 a90a               	lda #CALIB_FIRST_LINE
   281  c089 85fe               	sta TARGET_LINE
   282  c08b a200               	ldx #0
   283  c08d a5fe               -	lda TARGET_LINE                 ; 3
   284  c08f cd12d0             --	cmp SCREEN_RASTER_LINE          ; 4   (the read lands on the 4th cycle)
   285  c092 ea                 	nop                             ; 2
   286  c093 ea                 	nop                             ; 2
   287  c094 d0f9               	bne --                          ; 3 taken / 2 falling through
   288  c096 ad04dc             	lda CIA1_TIMER_A_LO             ; 4   (the read lands on the 4th cycle)
   289  c099 9deac0             	sta CalibReadings,x             ; 5   every reading is kept, so the work between two lines'
   290  c09c e8                 	inx                             ; 2   polls is always the same and the loop's position drifts
   291  c09d e6fe               	inc TARGET_LINE                 ; 5   by the same amount each line (7 on PAL, 5 on NTSC)
   292  c09f a5fe               	lda TARGET_LINE                 ; 3
   293  c0a1 c91a               	cmp #CALIB_FIRST_LINE + CALIB_LINES ; 2
   294  c0a3 d0e8               	bne -                           ; 3
   295                          	; The reading from the earliest exit is the largest, the others lie within 10 below it. If the
   296                          	; readings straddle the timer's reload, the ones from the later exits have wrapped to the top
   297                          	; of the period and the earliest is then the largest of those below 11.
   298  c0a5 a9ff               	lda #255
   299  c0a7 8502               	sta FILLER
   300  c0a9 20bfc0             	jsr LargestCalibReading
   301  c0ac 85fd               	sta CALIB
   302  c0ae 38                 	sec
   303  c0af e502               	sbc FILLER                      ; largest minus smallest
   304  c0b1 c90b               	cmp #11
   305  c0b3 9009               	bcc +
   306  c0b5 a90b               	lda #11
   307  c0b7 8502               	sta FILLER                      ; only readings below 11 count
   308  c0b9 20bfc0             	jsr LargestCalibReading
   309  c0bc 85fd               	sta CALIB
   310  c0be 60                 +	rts
   311                          
   312                          ; A = the largest reading below FILLER's value on entry (FILLER = 255 for all of them); FILLER
   313                          ; leaves with the smallest reading.
   314                          LargestCalibReading:
   315  c0bf a20f               	ldx #CALIB_LINES - 1
   316  c0c1 a900               	lda #0
   317  c0c3 85fe               	sta TARGET_LINE                 ; largest so far
   318  c0c5 a9ff               	lda #255
   319  c0c7 8dfac0             	sta LINE_CYCLES_SAVE            ; smallest so far
   320  c0ca bdeac0             -	lda CalibReadings,x
   321  c0cd c502               	cmp FILLER
   322  c0cf b00e               	bcs +                           ; at or above the limit: skip
   323  c0d1 c5fe               	cmp TARGET_LINE
   324  c0d3 9002               	bcc ++
   325  c0d5 85fe               	sta TARGET_LINE
   326  c0d7 cdfac0             ++	cmp LINE_CYCLES_SAVE
   327  c0da b003               	bcs +
   328  c0dc 8dfac0             	sta LINE_CYCLES_SAVE
   329  c0df ca                 +	dex
   330  c0e0 10e8               	bpl -
   331  c0e2 adfac0             	lda LINE_CYCLES_SAVE
   332  c0e5 8502               	sta FILLER
   333  c0e7 a5fe               	lda TARGET_LINE
   334  c0e9 60                 	rts
   335                          CalibReadings:
   336  c0ea 0000000000000000...	!fill CALIB_LINES, 0
   337                          LINE_CYCLES_SAVE:
   338  c0fa 00                 	!byte 0
   339                          
   340                          ; The slide entry for every possible timer difference (reference minus this poll's reading), so
   341                          ; SyncToLine needs no arithmetic that could branch or wrap. SyncToLine's poll gets out 3-9 cycles
   342                          ; into the line and reads the timer 3 cycles later, 6-12 cycles in against the reference's 10, so
   343                          ; the difference is -4 to +2 for a poll that made it, and the entry is SLIDE_CENTER plus that. The
   344                          ; difference can also come out a line period off, when the two readings straddle the timer's
   345                          ; reload: those entries are filled the same way. Everything else gets the nominal entry.
   346                          BuildSlideEntryTable:
   347  c0fb a200               	ldx #0
   348  c0fd a909               	lda #SLIDE_CENTER
   349  c0ff 9d00c3             -	sta SlideEntryTable,x
   350  c102 e8                 	inx
   351  c103 d0fa               	bne -
   352  c105 a2f8               	ldx #<-SLIDE_RANGE              ; difference, as a byte
   353  c107 a901               	lda #SLIDE_CENTER - SLIDE_RANGE ; its entry
   354  c109 8502               	sta FILLER
   355  c10b a502               -	lda FILLER
   356  c10d 9d00c3             	sta SlideEntryTable,x           ; difference as it is
   357  c110 8a                 	txa
   358  c111 18                 	clc
   359  c112 6503               	adc LINE_CYCLES
   360  c114 a8                 	tay
   361  c115 a502               	lda FILLER
   362  c117 9900c3             	sta SlideEntryTable,y           ; difference plus a period
   363  c11a 8a                 	txa
   364  c11b 38                 	sec
   365  c11c e503               	sbc LINE_CYCLES
   366  c11e a8                 	tay
   367  c11f a502               	lda FILLER
   368  c121 9900c3             	sta SlideEntryTable,y           ; difference minus a period
   369  c124 e602               	inc FILLER
   370  c126 e8                 	inx
   371  c127 e009               	cpx #SLIDE_RANGE + 1
   372  c129 d0e0               	bne -
   373  c12b 60                 	rts
   374                          
   375                          ClearScreen:
   376  c12c a200               	ldx #0
   377  c12e a920               	lda #$20
   378  c130 9d0004             -	sta SCREEN_RAM,x
   379  c133 9d0005             	sta SCREEN_RAM + $100,x
   380  c136 9d0006             	sta SCREEN_RAM + $200,x
   381  c139 9d0007             	sta SCREEN_RAM + $300,x
   382  c13c e8                 	inx
   383  c13d d0f1               	bne -
   384  c13f a901               	lda #COLOR_WHITE
   385  c141 9d00d8             -	sta COLOR_RAM,x
   386  c144 9d00d9             	sta COLOR_RAM + $100,x
   387  c147 9d00da             	sta COLOR_RAM + $200,x
   388  c14a 9d00db             	sta COLOR_RAM + $300,x
   389  c14d e8                 	inx
   390  c14e d0f1               	bne -
   391  c150 60                 	rts
   392                          
   393                          DrawScreen:
   394  c151 a200bdd3c9c9fff0...	+print SCREEN_RAM + 1 * 40, Text0
   395  c160 a200bde9c9c9fff0...	+print SCREEN_RAM + 3 * 40, Text1
   396  c16f a200bd0fcac9fff0...	+print SCREEN_RAM + 4 * 40, Text2
   397  c17e a200bd37cac9fff0...	+print SCREEN_RAM + 5 * 40, Text3
   398  c18d a200bd5fcac9fff0...	+print SCREEN_RAM + 7 * 40, Text4
   399  c19c a200bd87cac9fff0...	+print SCREEN_RAM + 8 * 40, Text5
   400  c1ab a200bdaccac9fff0...	+print SCREEN_RAM + 10 * 40, Text6
   401  c1ba a200bdd1cac9fff0...	+print SCREEN_RAM + 11 * 40, Text7
   402  c1c9 a200bdf3cac9fff0...	+print SCREEN_RAM + 12 * 40, Text8
   403  c1d8 a200bd18cbc9fff0...	+print SCREEN_RAM + 14 * 40, Text9
   404  c1e7 a200bd3acbc9fff0...	+print SCREEN_RAM + 15 * 40, Text10
   405  c1f6 a200bd61cbc9fff0...	+print SCREEN_RAM + 16 * 40, Text11
   406  c205 60                 	rts
   407                          
   408                          ; Wait for the raster line in TARGET_LINE and return 50 cycles into it (51 with SLIDE_CENTER 8),
   409                          ; on every frame and on every run. Uses A; X and Y are preserved so a caller can keep colours or counters in them.
   410                          SyncToLine:
   411  c206 8604               	stx SAVE_X
   412  c208 a5fecd12d0d0fbad...	+poll_and_read_clock            ; poll exits 3-9 cycles after the line began
   413  c212 49ff               	eor #$ff                        ; 2   reference minus this poll's clock value (larger the later
   414  c214 38                 	sec                             ; 2   the poll got out): CALIB + (255 - value) + 1
   415  c215 65fd               	adc CALIB                       ; 3
   416  c217 aa                 	tax                             ; 2
   417  c218 bd00c3             	lda SlideEntryTable,x           ; 4   later poll => larger entry => shorter delay
   418  c21b 8d1fc2             	sta SyncSlideJmp + 1            ; 4
   419                          SyncSlideJmp:
   420  c21e 4c00c4             	jmp SyncSlide                   ; 3
   421  c221 eaeaeaeaeaeaeaea...	!align 255, 0
   422                          SlideEntryTable:
   423  c300 0000000000000000...	!fill 256, 0
   424                          SyncSlide:
   425                          	; Entered at offset k (0-17) this takes 19 - k cycles: pairs of $C9 are CMP #$C9 (2 cycles);
   426                          	; the tail is either CMP $EA (3 cycles) or CMP #$C5 + NOP (4 cycles) depending on parity.
   427  c400 c9c9c9c9c9c9c9c9...	!byte $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c5, $ea
   428  c412 a604               	ldx SAVE_X                      ; 3
   429  c414 60                 	rts                             ; 6
   430                          
   431                          ; Raster interrupt: draw both bands, then leave the border black for the rest of the frame.
   432                          Irq:
   433                          	; 4-cycle band: three colours held in A, X and Y. The model is selected through A only, so
   434                          	; the two colours in X and Y survive into the band.
   435  c415 a922               	lda #BAND_A_LINE
   436  c417 85fe               	sta TARGET_LINE
   437  c419 a202               	ldx #2                          ; red
   438  c41b a00e               	ldy #14                         ; light blue
   439  c41d 2006c2             	jsr SyncToLine
   440  c420 a5fb               	lda IS_PAL
   441  c422 f005               	beq +
   442  c424 a901               	lda #COLOR_WHITE
   443  c426 4c4fc4             	jmp PalBandA
   444  c429 a901               +	lda #COLOR_WHITE
   445  c42b 4c9bc5             	jmp NtscBandA
   446                          BandADone:
   447  c42e a900               	lda #COLOR_BLACK                ; blank the two lines between the bands
   448  c430 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   449                          
   450                          	; 6-cycle band: a colour loaded per column.
   451  c433 a92b               	lda #BAND_B_LINE
   452  c435 85fe               	sta TARGET_LINE
   453  c437 2006c2             	jsr SyncToLine
   454  c43a a5fb               	lda IS_PAL
   455  c43c f003               	beq +
   456  c43e 4ceec6             	jmp PalBandB
   457  c441 4c5dc8             +	jmp NtscBandB
   458                          BandBDone:
   459                          
   460  c444 a900               	lda #COLOR_BLACK
   461  c446 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   462  c449 0e19d0             	asl $d019            ; acknowledge the interrupt by clearing the VIC's interrupt flag
   463  c44c 4c81ea             	jmp $ea81            ; jump into shorter ROM routine to only restore registers from the stack etc
   464                          
   465  c44f 8d20d08e20d08c20...	+band_a CYCLES_PER_LINE_PAL - BAND_A_COLUMNS * 4, BAND_A_LINES, ~PalBandA
   466  c598 4c2ec4             	jmp BandADone
   467  c59b 8d20d08e20d08c20...	+band_a CYCLES_PER_LINE_NTSC - BAND_A_COLUMNS * 4, BAND_A_LINES, ~NtscBandA
   468  c6eb 4c2ec4             	jmp BandADone
   469  c6ee a9028d20d0a9088d...	+band_b CYCLES_PER_LINE_PAL - BAND_B_COLUMNS * 6, BAND_B_LINES, ~PalBandB
   470  c85a 4c44c4             	jmp BandBDone
   471  c85d a9028d20d0a9088d...	+band_b CYCLES_PER_LINE_NTSC - BAND_B_COLUMNS * 6, BAND_B_LINES, ~NtscBandB
   472  c9d0 4c44c4             	jmp BandBDone
   473                          
   474                          ;------------------------------------------------------------
   475                          ;Text (screen codes, $ff terminated; lowercase source shows as uppercase)
   476                          ;------------------------------------------------------------
   477                          
   478  c9d3 1609032d09092003...Text0:	!scr "vic-ii colour columns", $ff
   479  c9e9 14080520020f1204...Text1:	!scr "the border colour takes effect at the", $ff
   480  ca0f 0319030c05200914...Text2:	!scr "cycle it is written, 8 pixels wide. how", $ff
   481  ca37 030c0f1305201408...Text3:	!scr "close the changes get is up to the cpu.", $ff
   482  ca5f 1510100512200201...Text4:	!scr "upper band: sta/stx/sty $d020 in a row,", $ff
   483  ca87 34200319030c0513...Text5:	!scr "4 cycles = 32 pixels, three colours.", $ff
   484  caac 0c0f170512200201...Text6:	!scr "lower band: lda #col then sta $d020,", $ff
   485  cad1 36200319030c0513...Text7:	!scr "6 cycles = 48 pixels, any colour.", $ff
   486  caf3 0f0e0520030f0c15...Text8:	!scr "one column per line is wider: a line", $ff
   487  cb18 0913200e0f142001...Text9:	!scr "is not a whole number of columns.", $ff
   488  cb3a 090e201408052002...Text10:	!scr "in the border: the vic-ii steals every", $ff
   489  cb61 381408200c090e05...Text11:	!scr "8th line's middle while display is on.", $ff
