   473                          ;Text (screen codes, $ff terminated; lowercase source shows as uppercase)
   474                          ;------------------------------------------------------------
   475                          
   476  c9d1 1609032d09092003...Text0:	!scr "vic-ii colour columns", $ff
   477  c9e7 14080520020f1204...Text1:	!scr "the border colour takes effect at the", $ff
   478  ca0d 0319030c05200914...Text2:	!scr "cycle it is written, 8 pixels wide. how", $ff
   479  ca35 030c0f1305201408...Text3:	!scr "close the changes get is up to the cpu.", $ff
   480  ca5d 1510100512200201...Text4:	!scr "upper band: sta/stx/sty $d020 in a row,", $ff
   481  ca85 34200319030c0513...Text5:	!scr "4 cycles = 32 pixels, three colours.", $ff
   482  caaa 0c0f170512200201...Text6:	!scr "lower band: lda #col then sta $d020,", $ff
   483  cacf 36200319030c0513...Text7:	!scr "6 cycles = 48 pixels, any colour.", $ff
   484  caf1 0f0e0520030f0c15...Text8:	!scr "one column per line is wider: a line", $ff
   485  cb16 0913200e0f142001...Text9:	!scr "is not a whole number of columns.", $ff
   486  cb38 090e201408052002...Text10:	!scr "in the border: the vic-ii steals every", $ff
   487  cb5f 381408200c090e05...Text11:	!scr "8th line's middle while display is on.", $ff
