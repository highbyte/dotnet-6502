
; ******** Source: raster_columns.asm
     1                          ;ACME assembler
     2                          ;!to "./raster_columns.prg"
     3                          
     4                          ; VIC-II colour columns: how finely the border colour can be changed along a raster line.
     5                          ;
     6                          ; The VIC-II applies a write to $D020 from the cycle the write lands on, so the picture has
     7                          ; 8-pixel (one cycle) granularity. What limits a program is the CPU: the fastest 6502 store to
     8                          ; an absolute address takes 4 cycles, so the highest column resolution is
     9                          ;
    10                          ;   4 cycles = 32 pixels = 4 character cells, using STA/STX/STY back to back.
    11                          ;
    12                          ; That rate needs the colours already in A, X and Y, so at most three colours repeat. Loading a
    13                          ; new colour costs 2 cycles more, giving
    14                          ;
    15                          ;   6 cycles = 48 pixels = 6 character cells, with any colour per column.
    16                          ;
    17                          ; Two bands in the top border show both. Every line of a band runs the same store sequence and
    18                          ; takes exactly one raster line (63 cycles on PAL, 65 on NTSC; the model is detected at start), so
    19                          ; the colour changes land at the same position on every line and the columns are vertical. The
    20                          ; store sequence is written out for every line of a band rather than looped, because a loop's own
    21                          ; counter and branch would cost 8 cycles per line, a 64-pixel column of nothing. A raster line is
    22                          ; still not a whole number of columns, so one column per line is wider by the remainder: 3 cycles
    23                          ; on PAL, 5 on NTSC.
    24                          ;
    25                          ; The effect runs in the border to keep it simple. With the display on, one raster line in eight is
    26                          ; a bad line: the VIC-II takes the bus for about 40 cycles in the middle of it to fetch the video
    27                          ; matrix, and the CPU stops at its next opcode fetch. That window covers the whole visible part of
    28                          ; that one line, so it comes out in a single colour; the other seven lines are untouched and take
    29                          ; columns at the same rate as the border does. Keeping those seven lines in step across the stolen
    30                          ; cycles is the work, and screen_columns.asm does it. Above raster line 48 no bad line can occur,
    31                          ; whatever YSCROLL is, so the top border needs none of that.
    32                          ;
    33                          ; A raster interrupt alone is not accurate enough to place columns: it arrives a few cycles late
    34                          ; depending on the instruction it interrupts, and the raster line poll that follows is only
    35                          ; accurate to its 7-cycle loop, so the columns would jump sideways from frame to frame. CIA 1
    36                          ; timer A is therefore run as a free line clock (period = one raster line), force-loaded once at a
    37                          ; fixed offset from a raster poll. Every later poll reads the timer at the matching offset, and the
    38                          ; value tells how early or late this frame is; a 1-cycle-resolution delay slide absorbs it.
    39                          
    40                          ;code start address
    41                          * = $c000
    42                          
    43                          ;------------------------------------------------------------
    44                          ;Program settings
    45                          ;------------------------------------------------------------
    46                          
    47                          SCREEN_CONTROL_REGISTER_1 = $d011
    48                          SCREEN_RASTER_LINE = $d012
    49                          SCREEN_BORDER_COLOR_ADDRESS = $d020
    50                          SCREEN_BACKGROUND_COLOR_ADDRESS = $d021
    51                          
    52                          CIA1_TIMER_A_LO = $dc04
    53                          CIA1_TIMER_A_HI = $dc05
    54                          CIA1_CONTROL_A = $dc0e
    55                          
    56                          SCREEN_RAM = $0400
    57                          COLOR_RAM = $d800
    58                          
    59                          IS_PAL = $fb            ; zero page: 1 on PAL, 0 on NTSC
    60                          LAST_LINE_LO = $fc      ; zero page: scratch for the model detection
    61                          CALIB = $fd             ; zero page: line clock value of the reference poll (see SyncToLine)
    62                          TARGET_LINE = $fe       ; zero page: raster line SyncToLine waits for
    63                          FILLER = $02            ; zero page: scratch, also the byte the timing filler reads
    64                          
    65                          ; Both bands sit below raster line 50, where no bad line can occur with the default YSCROLL of 3,
    66                          ; and inside the part of the top border that both models actually show: PAL's visible top border
    67                          ; starts at raster line 9 but NTSC's only at 34.
    68                          ; A band starts partway into its first line and so ends partway into the line after its last, which
    69                          ; is why the second band's first line is two lines after the first band's last: its wait would
    70                          ; otherwise be for a line that has just gone by, and would sit out a whole frame.
    71                          BAND_A_LINE = 34        ; first raster line of the 4-cycle band
    72                          BAND_A_LINES = 7
    73                          BAND_B_LINE = 43        ; first raster line of the 6-cycle band
    74                          BAND_B_LINES = 7
    75                          
    76                          CYCLES_PER_LINE_PAL = 63
    77                          CYCLES_PER_LINE_NTSC = 65
    78                          
    79                          BAND_A_COLUMNS = 15     ; 15 * 4 = 60 cycles of columns
    80                          BAND_B_COLUMNS = 10     ; 10 * 6 = 60 cycles of columns
    81                          
    82                          ; Slide entry for a frame exactly as early as the reference frame. The poll loop is 7 cycles, so a
    83                          ; frame differs from the reference by at most 6 cycles either way and the entry stays within 3-15.
    84                          SLIDE_CENTER = 9
    85                          
    86                          COLOR_BLACK = 0
    87                          COLOR_WHITE = 1
    88                          
    89                          ;------------------------------------------------------------
    90                          ;Macros
    91                          ;------------------------------------------------------------
    92                          
    93                          ; Burn .cycles cycles (>= 2). NOPs in pairs, with a 3-cycle BIT for an odd count.
    94                          !macro delay_cycles .cycles {
    95                          	!if .cycles & 1 {
    96                          		bit FILLER
    97                          		!fill (.cycles - 3) / 2, $ea
    98                          	} else {
    99                          		!fill .cycles / 2, $ea
   100                          	}
   101                          }
   102                          
   103                          ; Wait for the raster line in TARGET_LINE, then read the line clock. Written once and used both by
   104                          ; the calibration in Init and by SyncToLine, so the clock is always read at the same offset after
   105                          ; the poll and the two values can be compared directly.
   106                          !macro poll_and_read_clock {
   107                          	lda TARGET_LINE                 ; 3
   108                          -	cmp SCREEN_RASTER_LINE          ; 4
   109                          	bne -                           ; 3 taken / 2 falling through
   110                          	lda CIA1_TIMER_A_LO             ; 4   (the read lands on the 4th cycle)
   111                          }
   112                          
   113                          ; Copy a $ff-terminated screen-code string to screen memory.
   114                          !macro print .screenaddr, .text {
   115                          	ldx #0
   116                          -	lda .text,x
   117                          	cmp #$ff
   118                          	beq +
   119                          	sta .screenaddr,x
   120                          	inx
   121                          	bne -
   122                          +
   123                          }
   124                          
   125                          ; The 4-cycle band, written out line by line: 15 stores from the three preloaded colour registers,
   126                          ; then the remainder of the raster line. 15 is a multiple of 3, so every line starts on the same
   127                          ; colour and the columns line up vertically.
   128                          !macro band_a .fill, .lines, ~.entry {
   129                          .Start:
   130                          	!for .line, 1, .lines {
   131                          		!for .group, 1, BAND_A_COLUMNS / 3 {
   132                          			sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   133                          			stx SCREEN_BORDER_COLOR_ADDRESS     ; 4
   134                          			sty SCREEN_BORDER_COLOR_ADDRESS     ; 4
   135                          		}
   136                          		+delay_cycles .fill
   137                          	}
   138                          	.entry = .Start
   139                          }
   140                          
   141                          ; One line of the 6-cycle band: 10 columns, each loading its own colour first.
   142                          !macro band_b_line {
   143                          	lda #2                              ; 2   red
   144                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   145                          	lda #8                              ; 2   orange
   146                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   147                          	lda #7                              ; 2   yellow
   148                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   149                          	lda #5                              ; 2   green
   150                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   151                          	lda #13                             ; 2   light green
   152                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   153                          	lda #3                              ; 2   cyan
   154                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   155                          	lda #14                             ; 2   light blue
   156                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   157                          	lda #6                              ; 2   blue
   158                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   159                          	lda #4                              ; 2   purple
   160                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   161                          	lda #1                              ; 2   white
   162                          	sta SCREEN_BORDER_COLOR_ADDRESS     ; 4
   163                          }
   164                          
   165                          ; The 6-cycle band, written out line by line.
   166                          !macro band_b .fill, .lines, ~.entry {
   167                          .Start:
   168                          	!for .line, 1, .lines {
   169                          		+band_b_line
   170                          		+delay_cycles .fill
   171                          	}
   172                          	.entry = .Start
   173                          }
   174                          
   175                          ;------------------------------------------------------------
   176                          ;Code start
   177                          ;------------------------------------------------------------
   178                          
   179                          Init:
   180  c000 78                 	sei                  ; set interrupt bit, make the CPU ignore interrupt requests
   181  c001 a97f               	lda #%01111111       ; switch off interrupt signals from CIA-1
   182  c003 8d0ddc             	sta $dc0d
   183                          
   184  c006 2d11d0             	and SCREEN_CONTROL_REGISTER_1 ; clear most significant bit of VIC's raster register
   185  c009 8d11d0             	sta SCREEN_CONTROL_REGISTER_1
   186                          
   187  c00c ad0ddc             	lda $dc0d            ; acknowledge pending interrupts from CIA-1
   188  c00f ad0ddd             	lda $dd0d            ; acknowledge pending interrupts from CIA-2
   189                          
   190  c012 2065c0             	jsr DetectModel
   191                          
   192  c015 a900               	lda #COLOR_BLACK
   193  c017 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   194  c01a 8d21d0             	sta SCREEN_BACKGROUND_COLOR_ADDRESS
   195  c01d 2089c0             	jsr ClearScreen
   196  c020 20aec0             	jsr DrawScreen
   197                          
   198                          	; Line clock: timer A counts one raster line per period (latch + 1 cycles), continuously.
   199  c023 a900               	lda #0
   200  c025 8d05dc             	sta CIA1_TIMER_A_HI
   201  c028 a940               	lda #CYCLES_PER_LINE_NTSC - 1
   202  c02a a6fb               	ldx IS_PAL
   203  c02c f002               	beq +
   204  c02e a93e               	lda #CYCLES_PER_LINE_PAL - 1
   205  c030 8d04dc             +	sta CIA1_TIMER_A_LO
   206                          
   207  c033 a911               	lda #%00010001       ; force load + start, continuous
   208  c035 8d0edc             	sta CIA1_CONTROL_A
   209                          
   210                          	; Calibration: run the poll once and keep the clock value it produces. Every later poll is
   211                          	; compared against this, so the effect aligns to this frame whatever the code layout is.
   212  c038 a922               	lda #BAND_A_LINE
   213  c03a 85fe               	sta TARGET_LINE
   214  c03c a5fecd12d0d0fbad...	+poll_and_read_clock
   215  c046 85fd               	sta CALIB
   216                          
   217                          	; Raster IRQ two lines above the first band: interrupt latency and the KERNAL's interrupt
   218                          	; entry take more than one raster line, and the handler must reach its poll in time.
   219  c048 a920               	lda #BAND_A_LINE - 2
   220  c04a 8d12d0             	sta SCREEN_RASTER_LINE
   221  c04d a913               	lda #<Irq
   222  c04f 8d1403             	sta $0314
   223  c052 a9c2               	lda #>Irq
   224  c054 8d1503             	sta $0315
   225                          
   226  c057 a90f               	lda #%00001111       ; clear any pending VIC interrupt flag
   227  c059 8d19d0             	sta $d019
   228  c05c a901               	lda #%00000001       ; enable raster interrupt signals from VIC
   229  c05e 8d1ad0             	sta $d01a
   230                          
   231  c061 58                 	cli                  ; clear interrupt flag, allowing the CPU to respond to interrupt requests
   232  c062 4c62c0             	jmp *
   233                          
   234                          ; PAL or NTSC: after the raster passes line 255, remember the last low byte seen before it wraps
   235                          ; to 0. NTSC wraps after line 262 (low byte 6), PAL after line 311 (low byte 55).
   236                          DetectModel:
   237  c065 a900               	lda #0
   238  c067 85fc               	sta LAST_LINE_LO
   239  c069 2c11d0             -	bit SCREEN_CONTROL_REGISTER_1
   240  c06c 10fb               	bpl -
   241                          	; Keep the highest line low byte seen while bit 8 is set, rather than the last one: the raster
   242                          	; can wrap to 0 between reading the line and testing bit 8, and the last value would then be 0
   243                          	; on either model. That misread makes the effect use the wrong line length on PAL.
   244  c06e ad12d0             -	lda SCREEN_RASTER_LINE
   245  c071 c5fc               	cmp LAST_LINE_LO
   246  c073 9002               	bcc +
   247  c075 85fc               	sta LAST_LINE_LO
   248  c077 2c11d0             +	bit SCREEN_CONTROL_REGISTER_1
   249  c07a 30f2               	bmi -
   250  c07c a900               	lda #0
   251  c07e 85fb               	sta IS_PAL
   252  c080 a5fc               	lda LAST_LINE_LO
   253  c082 c920               	cmp #$20
   254  c084 9002               	bcc +
   255  c086 e6fb               	inc IS_PAL
   256  c088 60                 +	rts
   257                          
   258                          ClearScreen:
   259  c089 a200               	ldx #0
   260  c08b a920               	lda #$20
   261  c08d 9d0004             -	sta SCREEN_RAM,x
   262  c090 9d0005             	sta SCREEN_RAM + $100,x
   263  c093 9d0006             	sta SCREEN_RAM + $200,x
   264  c096 9d0007             	sta SCREEN_RAM + $300,x
   265  c099 e8                 	inx
   266  c09a d0f1               	bne -
   267  c09c a901               	lda #COLOR_WHITE
   268  c09e 9d00d8             -	sta COLOR_RAM,x
   269  c0a1 9d00d9             	sta COLOR_RAM + $100,x
   270  c0a4 9d00da             	sta COLOR_RAM + $200,x
   271  c0a7 9d00db             	sta COLOR_RAM + $300,x
   272  c0aa e8                 	inx
   273  c0ab d0f1               	bne -
   274  c0ad 60                 	rts
   275                          
   276                          DrawScreen:
   277  c0ae a200bdd1c7c9fff0...	+print SCREEN_RAM + 1 * 40, Text0
   278  c0bd a200bde7c7c9fff0...	+print SCREEN_RAM + 3 * 40, Text1
   279  c0cc a200bd0dc8c9fff0...	+print SCREEN_RAM + 4 * 40, Text2
   280  c0db a200bd35c8c9fff0...	+print SCREEN_RAM + 5 * 40, Text3
   281  c0ea a200bd5dc8c9fff0...	+print SCREEN_RAM + 7 * 40, Text4
   282  c0f9 a200bd85c8c9fff0...	+print SCREEN_RAM + 8 * 40, Text5
   283  c108 a200bdaac8c9fff0...	+print SCREEN_RAM + 10 * 40, Text6
   284  c117 a200bdcfc8c9fff0...	+print SCREEN_RAM + 11 * 40, Text7
   285  c126 a200bdf1c8c9fff0...	+print SCREEN_RAM + 12 * 40, Text8
   286  c135 a200bd16c9c9fff0...	+print SCREEN_RAM + 14 * 40, Text9
   287  c144 a200bd38c9c9fff0...	+print SCREEN_RAM + 15 * 40, Text10
   288  c153 a200bd5fc9c9fff0...	+print SCREEN_RAM + 16 * 40, Text11
   289  c162 60                 	rts
   290                          
   291                          ; Wait for the raster line in TARGET_LINE and return at the same cycle offset into that line on
   292                          ; every frame. Uses A; leaves X and Y alone so a band can keep its colours in them.
   293                          SyncToLine:
   294  c163 a5fecd12d0d0fbad...	+poll_and_read_clock            ; poll exits 0-6 cycles after the line began
   295  c16d 8502               	sta FILLER                      ; 3   this frame's clock value
   296  c16f a5fd               	lda CALIB                       ; 3
   297  c171 38                 	sec                             ; 2
   298  c172 e502               	sbc FILLER                      ; 3   reference minus this frame: negative if this frame is late
   299  c174 18                 	clc                             ; 2
   300  c175 6909               	adc #SLIDE_CENTER               ; 2   later frame => larger entry => shorter delay
   301  c177 290f               	and #15                         ; 2   a jump into the slide even if the poll ever missed a frame
   302  c179 8d7dc1             	sta SyncSlideJmp + 1            ; 4
   303                          SyncSlideJmp:
   304  c17c 4c00c2             	jmp SyncSlide                   ; 3
   305  c17f eaeaeaeaeaeaeaea...	!align 255, 0
   306                          SyncSlide:
   307                          	; Entered at offset k (0-17) this takes 19 - k cycles: pairs of $C9 are CMP #$C9 (2 cycles);
   308                          	; the tail is either CMP $EA (3 cycles) or CMP #$C5 + NOP (4 cycles) depending on parity.
   309  c200 c9c9c9c9c9c9c9c9...	!byte $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c9, $c5, $ea
   310  c212 60                 	rts
   311                          
   312                          ; Raster interrupt: draw both bands, then leave the border black for the rest of the frame.
   313                          Irq:
   314                          	; 4-cycle band: three colours held in A, X and Y. The model is selected through A only, so
   315                          	; the two colours in X and Y survive into the band.
   316  c213 a922               	lda #BAND_A_LINE
   317  c215 85fe               	sta TARGET_LINE
   318  c217 a202               	ldx #2                          ; red
   319  c219 a00e               	ldy #14                         ; light blue
   320  c21b 2063c1             	jsr SyncToLine
   321  c21e a5fb               	lda IS_PAL
   322  c220 f005               	beq +
   323  c222 a901               	lda #COLOR_WHITE
   324  c224 4c4dc2             	jmp PalBandA
   325  c227 a901               +	lda #COLOR_WHITE
   326  c229 4c99c3             	jmp NtscBandA
   327                          BandADone:
   328  c22c a900               	lda #COLOR_BLACK                ; blank the two lines between the bands
   329  c22e 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   330                          
   331                          	; 6-cycle band: a colour loaded per column.
   332  c231 a92b               	lda #BAND_B_LINE
   333  c233 85fe               	sta TARGET_LINE
   334  c235 2063c1             	jsr SyncToLine
   335  c238 a5fb               	lda IS_PAL
   336  c23a f003               	beq +
   337  c23c 4cecc4             	jmp PalBandB
   338  c23f 4c5bc6             +	jmp NtscBandB
   339                          BandBDone:
   340                          
   341  c242 a900               	lda #COLOR_BLACK
   342  c244 8d20d0             	sta SCREEN_BORDER_COLOR_ADDRESS
   343  c247 0e19d0             	asl $d019            ; acknowledge the interrupt by clearing the VIC's interrupt flag
   344  c24a 4c81ea             	jmp $ea81            ; jump into shorter ROM routine to only restore registers from the stack etc
   345                          
   346  c24d 8d20d08e20d08c20...	+band_a CYCLES_PER_LINE_PAL - BAND_A_COLUMNS * 4, BAND_A_LINES, ~PalBandA
   347  c396 4c2cc2             	jmp BandADone
   348  c399 8d20d08e20d08c20...	+band_a CYCLES_PER_LINE_NTSC - BAND_A_COLUMNS * 4, BAND_A_LINES, ~NtscBandA
   349  c4e9 4c2cc2             	jmp BandADone
   350  c4ec a9028d20d0a9088d...	+band_b CYCLES_PER_LINE_PAL - BAND_B_COLUMNS * 6, BAND_B_LINES, ~PalBandB
   351  c658 4c42c2             	jmp BandBDone
   352  c65b a9028d20d0a9088d...	+band_b CYCLES_PER_LINE_NTSC - BAND_B_COLUMNS * 6, BAND_B_LINES, ~NtscBandB
   353  c7ce 4c42c2             	jmp BandBDone
   354                          
