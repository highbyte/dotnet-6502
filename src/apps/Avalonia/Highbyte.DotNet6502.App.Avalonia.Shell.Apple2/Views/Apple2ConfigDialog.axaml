<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.ViewModels"
        xmlns:views="using:Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.Views"
        x:Class="Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.Views.Apple2ConfigDialog"
        x:DataType="vm:Apple2ConfigDialogViewModel"
        AutomationProperties.AutomationId="Apple2ConfigDialog"
        AutomationProperties.Name="Apple II configuration"
        Title="Apple II Configuration"
        Width="760"
        Height="640"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        WindowDecorations="Full"
        ShowInTaskbar="False"
        Background="{DynamicResource ViewDefaultBg}">

    <views:Apple2ConfigDialogView x:Name="ConfigView"
                                  ConfigurationChanged="OnConfigurationChanged"/>
</Window>
