<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.ViewModels"
             x:Class="Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.Views.Apple2ConfigDialogView"
             x:DataType="vm:Apple2ConfigDialogViewModel"
             AutomationProperties.AutomationId="Apple2ConfigDialogView"
             AutomationProperties.Name="Apple II configuration"
             MinWidth="480">

    <!-- Root must be a Grid so OverlayDialogHelper can host overlay dialogs
         (e.g. the ROM licence acknowledgement prompt) on top of this view. -->
    <Grid>
    <ScrollViewer Classes="auto-scroll">
        <StackPanel Classes="spacing-tight" Margin="10">

            <!-- ROMs -->
            <TextBlock Text="ROMs" Classes="bold"/>
            <Border Classes="section-container">
                <StackPanel Classes="spacing-tight">

                    <TextBlock Text="{Binding RomStatusSummary}"
                               AutomationProperties.AutomationId="RomStatusSummaryText"
                               Classes="small secondary-text"/>

                    <ItemsControl ItemsSource="{Binding RomStatuses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:Apple2RomStatusViewModel">
                                <Grid Classes="spacing-tight" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Classes="small"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                             AutomationProperties.AutomationId="{Binding Name, StringFormat='RomFileTextBox.{0}'}"
                                             AutomationProperties.Name="{Binding Name, StringFormat='{}{0} ROM file name'}"
                                             Text="{Binding RomFile, Mode=TwoWay}"
                                             IsVisible="{Binding !IsRunningInWebAssembly}"
                                             Classes="small"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Details}"
                                               Foreground="{Binding ForegroundColor}"
                                               Classes="small"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Classes="spacing-tight" IsVisible="{Binding !IsRunningInWebAssembly}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="ROM directory:"
                                   Classes="small secondary-text"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="RomDirectoryTextBox"
                                 AutomationProperties.Name="ROM directory"
                                 Text="{Binding RomDirectory, Mode=TwoWay}"
                                 ToolTip.Tip="{Binding RomDirectoryToolTip}"
                                 Classes="small"
                                 Margin="8,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Load ROM files…"
                                AutomationProperties.AutomationId="LoadRomsButton"
                                Classes="small"
                                IsVisible="{Binding !IsRunningInWebAssembly}"
                                Click="LoadRoms_Click"/>
                        <Button Content="Download ROMs"
                                AutomationProperties.AutomationId="DownloadRomsToFilesButton"
                                AutomationProperties.Name="Download ROMs to the ROM directory"
                                Classes="small"
                                IsVisible="{Binding !IsRunningInWebAssembly}"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding DownloadRomsToFilesCommand}"/>
                        <Button Content="Download ROMs"
                                AutomationProperties.AutomationId="DownloadRomsToMemoryButton"
                                AutomationProperties.Name="Download ROMs into browser storage"
                                Classes="small"
                                IsVisible="{Binding IsRunningInWebAssembly}"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding DownloadRomsToByteArrayCommand}"/>
                        <Button Content="Clear ROMs"
                                AutomationProperties.AutomationId="ClearRomsButton"
                                Classes="small"
                                IsEnabled="{Binding IsNotBusy}"
                                Command="{Binding ClearRomsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Display -->
            <TextBlock Text="Display" Classes="bold"/>
            <Border Classes="section-container">
                <StackPanel Classes="spacing-tight">
                    <Grid Classes="spacing-tight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Monitor colour:" Classes="small secondary-text" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.AutomationId="MonitorColorComboBox"
                                  AutomationProperties.Name="Monitor colour"
                                  ItemsSource="{Binding MonitorColors}"
                                  SelectedItem="{Binding SelectedMonitorColor, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  Classes="small"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedMonitorColorHelpText}" Classes="small secondary-text" TextWrapping="Wrap"/>

                    <Grid Classes="spacing-tight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Render provider:" Classes="small secondary-text" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.AutomationId="RenderProviderComboBox"
                                  AutomationProperties.Name="Render provider"
                                  ItemsSource="{Binding RenderProviders}"
                                  SelectedItem="{Binding SelectedRenderProvider, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  Classes="small"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedRenderProviderHelpText}" Classes="small secondary-text" TextWrapping="Wrap"/>

                    <Grid Classes="spacing-tight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Render target:" Classes="small secondary-text" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.AutomationId="RenderTargetComboBox"
                                  AutomationProperties.Name="Render target"
                                  ItemsSource="{Binding RenderTargets}"
                                  SelectedItem="{Binding SelectedRenderTarget, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  Classes="small"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedRenderTargetHelpText}" Classes="small secondary-text" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- CPU -->
            <TextBlock Text="CPU" Classes="bold"/>
            <Border Classes="section-container">
                <StackPanel Classes="spacing-tight">
                    <Grid Classes="spacing-tight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Compatibility:" Classes="small secondary-text" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.AutomationId="CpuCompatibilityProfileComboBox"
                                  AutomationProperties.Name="CPU compatibility profile"
                                  ItemsSource="{Binding CpuCompatibilityProfiles}"
                                  SelectedItem="{Binding SelectedCpuCompatibilityProfile, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  Classes="small"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedCpuCompatibilityProfileHelpText}" Classes="small secondary-text" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Messages -->
            <TextBlock Text="{Binding StatusMessage}"
                       AutomationProperties.AutomationId="ConfigStatusMessageText"
                       IsVisible="{Binding HasStatusMessage}"
                       Classes="small secondary-text"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ValidationMessage}"
                       AutomationProperties.AutomationId="ConfigValidationMessageText"
                       IsVisible="{Binding HasValidationMessage}"
                       Foreground="#F56565"
                       Classes="small"
                       TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Reset to defaults"
                        AutomationProperties.AutomationId="ResetToDefaultsButton"
                        Classes="small"
                        IsEnabled="{Binding IsNotBusy}"
                        Command="{Binding ResetToDefaultsCommand}"/>
                <Button Content="Cancel"
                        AutomationProperties.AutomationId="CancelButton"
                        Classes="small cancel"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{Binding OkButtonText}"
                        AutomationProperties.AutomationId="OkButton"
                        AutomationProperties.Name="Save configuration"
                        Classes="small primary"
                        IsEnabled="{Binding CanSave}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
