<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.ViewModels"
             xmlns:controls="using:Highbyte.DotNet6502.App.Avalonia.Core.Controls"
             x:Class="Highbyte.DotNet6502.App.Avalonia.Shell.Apple2.Views.Apple2MenuView"
             x:DataType="vm:Apple2MenuViewModel"
             AutomationProperties.AutomationId="Apple2MenuView"
             AutomationProperties.Name="Apple II menu">

    <StackPanel Classes="spacing-tight">
        <!-- Copy/Paste buttons -->
        <Grid Classes="spacing-tight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Copy"
                    AutomationProperties.AutomationId="CopyBasicButton"
                    AutomationProperties.Name="Copy BASIC source to clipboard"
                    Command="{Binding CopyBasicSourceCommand}"
                    Classes="small"/>
            <Button Grid.Column="1"
                    Content="Paste"
                    AutomationProperties.AutomationId="PasteTextButton"
                    AutomationProperties.Name="Paste text from clipboard"
                    Command="{Binding PasteTextCommand}"
                    Classes="small"/>
        </Grid>

        <!-- Download & Run programs: downloads a .dsk and injects a program from its catalog
             straight into RAM, no drive involved. Booting a disk lives in the Disk drive
             section below. -->
        <Button Name="DownloadSectionHeader"
                AutomationProperties.AutomationId="DownloadSectionHeader"
                AutomationProperties.Name="Toggle Download and Run section"
                Classes="section-toggle"
                Command="{Binding ToggleDownloadSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleRight"
                                         IsVisible="{Binding !IsDownloadSectionExpanded}"/>
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleDown"
                                         IsVisible="{Binding IsDownloadSectionExpanded}"/>
                </Grid>
                <TextBlock Text="Download &amp; Run programs" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Name="DownloadSectionContent"
                AutomationProperties.AutomationId="DownloadSectionContent"
                Classes="collapsible-content"
                IsVisible="{Binding IsDownloadSectionExpanded}">
            <StackPanel Classes="spacing-tight">
                <TextBlock Text="Download a known program and run it. Disk-booting titles need the disk2 ROM."
                           TextWrapping="Wrap"
                           Classes="small secondary-text"/>

                <ComboBox AutomationProperties.AutomationId="PreloadedDiskComboBox"
                          AutomationProperties.Name="Downloadable program"
                          ItemsSource="{Binding PreloadedPrograms}"
                          SelectedValue="{Binding SelectedPreloadedProgram}"
                          DisplayMemberBinding="{Binding Value}"
                          SelectedValueBinding="{Binding Key}"
                          HorizontalAlignment="Stretch"/>

                <Button Content="Download &amp; run"
                        AutomationProperties.AutomationId="DownloadAndRunDiskButton"
                        AutomationProperties.Name="Download and run the selected program"
                        IsVisible="{Binding SelectedPreloadedProgram, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding LoadPreloadedProgramCommand}"
                        Classes="small"/>

                <TextBlock Text="Downloading and starting program..."
                           IsVisible="{Binding IsLoadingPreloadedProgram}"
                           Classes="small secondary-text"/>

                <Border Classes="error-container-small"
                        IsVisible="{Binding HasLatestPreloadedProgramError}">
                    <TextBlock Text="{Binding LatestPreloadedProgramError}"
                               TextWrapping="Wrap"
                               Classes="small"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Disk drive: real Disk II emulation — insert a disk image and boot from it. -->
        <Button Name="DiskSectionHeader"
                AutomationProperties.AutomationId="DiskSectionHeader"
                AutomationProperties.Name="Toggle Disk drive section"
                Classes="section-toggle"
                Command="{Binding ToggleDiskSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleRight"
                                         IsVisible="{Binding !IsDiskSectionExpanded}"/>
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleDown"
                                         IsVisible="{Binding IsDiskSectionExpanded}"/>
                </Grid>
                <TextBlock Text="Disk drive" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Name="DiskSectionContent"
                AutomationProperties.AutomationId="DiskSectionContent"
                Classes="collapsible-content"
                IsVisible="{Binding IsDiskSectionExpanded}">
            <StackPanel Classes="spacing-tight">
                <TextBlock Text="Insert a DOS 3.3 disk image in drive 1. Boot from it, or — once DOS is running — just swap disks and use CATALOG, BRUN and friends."
                           TextWrapping="Wrap"
                           Classes="small secondary-text"/>

                <!-- Name is bound to the same text as Content so the accessibility tree reports
                     what the button does *now* ("Insert .dsk image" / "Eject disk"); a static
                     name would override the state-bound caption and hide the drive's state. -->
                <Button Content="{Binding DiskToggleButtonText}"
                        Name="DiskToggleButton"
                        AutomationProperties.AutomationId="DiskToggleButton"
                        AutomationProperties.Name="{Binding DiskToggleButtonText}"
                        Click="ToggleDiskImage_Click"
                        Classes="small"/>

                <!-- A blank data disk to save things onto. Not bootable, so it is offered
                     alongside insert rather than as a way to start the machine. -->
                <Button Content="New blank disk"
                        Name="NewBlankDiskButton"
                        AutomationProperties.AutomationId="NewBlankDiskButton"
                        AutomationProperties.Name="Insert a new blank DOS 3.3 disk in drive 1"
                        Command="{Binding NewBlankDiskCommand}"
                        Classes="small"/>

                <!-- Unlike the toggle above, this caption is static, so a descriptive Name is
                     kept: it spells out what the "PR#6" jargon in the caption means. -->
                <Button Content="Boot from disk (PR#6)"
                        Name="BootDiskButton"
                        AutomationProperties.AutomationId="BootDiskButton"
                        AutomationProperties.Name="Boot the machine from the disk in drive 1"
                        IsVisible="{Binding HasInsertedDisk}"
                        Command="{Binding BootDiskCommand}"
                        Classes="small"/>

                <!-- The write-protect notch. Disabled when the backing file cannot be written, with
                     the reason in the tooltip: "you may not write this" and "you cannot write this"
                     are different statements, and a box that offers something it cannot deliver is
                     worse than one that explains itself. -->
                <CheckBox Content="Write enabled"
                          Name="DiskWriteEnabledCheckBox"
                          AutomationProperties.AutomationId="DiskWriteEnabledCheckBox"
                          AutomationProperties.Name="Allow the machine to write to the inserted disk"
                          IsVisible="{Binding HasInsertedDisk}"
                          IsEnabled="{Binding CanEnableDiskWrite}"
                          IsChecked="{Binding IsDiskWriteEnabled, Mode=TwoWay}"
                          ToolTip.Tip="{Binding DiskWriteDisabledReason}"
                          Classes="small"/>

                <TextBlock Text="Changes are kept in memory — use Save disk image to keep them."
                           AutomationProperties.AutomationId="DiskSaveHintText"
                           IsVisible="{Binding MustSaveDiskImageExplicitly}"
                           TextWrapping="Wrap"
                           Classes="small secondary-text"/>

                <Button Content="Save disk image"
                        Name="SaveDiskImageButton"
                        AutomationProperties.AutomationId="SaveDiskImageButton"
                        AutomationProperties.Name="Save the inserted disk image to a file"
                        IsVisible="{Binding HasInsertedDisk}"
                        Click="SaveDiskImage_Click"
                        Classes="small"/>

                <TextBlock Text="{Binding DriveStatusText}"
                           AutomationProperties.AutomationId="DriveStatusText"
                           TextWrapping="Wrap"
                           Classes="small secondary-text"/>
            </StackPanel>
        </Border>

        <!-- Load/Save -->
        <Button Name="LoadSaveSectionHeader"
                AutomationProperties.AutomationId="LoadSaveSectionHeader"
                AutomationProperties.Name="Toggle Load/Save section"
                Classes="section-toggle"
                Command="{Binding ToggleLoadSaveSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleRight"
                                         IsVisible="{Binding !IsLoadSaveSectionExpanded}"/>
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleDown"
                                         IsVisible="{Binding IsLoadSaveSectionExpanded}"/>
                </Grid>
                <TextBlock Text="Load/Save" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Name="LoadSaveSectionContent"
                AutomationProperties.AutomationId="LoadSaveSectionContent"
                Classes="collapsible-content"
                IsVisible="{Binding IsLoadSaveSectionExpanded}">
            <StackPanel Classes="spacing-tight">
                <TextBlock Text="Load/save Applesoft Basic files"
                           Classes="small secondary-text"/>

                <Grid Classes="spacing-tight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Load Basic"
                            AutomationProperties.AutomationId="LoadBasicButton"
                            IsEnabled="{Binding IsFileOperationEnabled}"
                            Click="LoadBasicFile_Click"
                            Classes="small"/>
                    <Button Grid.Column="1"
                            Content="Save Basic"
                            AutomationProperties.AutomationId="SaveBasicButton"
                            IsEnabled="{Binding IsFileOperationEnabled}"
                            Click="SaveBasicFile_Click"
                            Classes="small"/>
                </Grid>

                <Button Content="Load &amp; start binary"
                        AutomationProperties.AutomationId="LoadBinaryButton"
                        Classes="primary small"
                        IsEnabled="{Binding IsFileOperationEnabled}"
                        Click="LoadBinaryFile_Click"/>

                <TextBlock Text="Load a file from a DOS 3.3 .dsk image (RAM-resident programs only)"
                           TextWrapping="Wrap"
                           Classes="small secondary-text"/>

                <Button Content="Load file from .dsk image"
                        AutomationProperties.AutomationId="LoadFromDskButton"
                        AutomationProperties.Name="Load file from .dsk disk image"
                        ToolTip.Tip="Pick a DOS 3.3 .dsk/.do image, then choose a catalog file to load into memory and run. No Disk II emulation — the image is a file source only."
                        Click="OpenDskImage_Click"
                        IsEnabled="{Binding IsFileOperationEnabled}"
                        Classes="small"/>

                <TextBlock Text="{Binding DiskStatusText}"
                           IsVisible="{Binding DiskStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           Classes="small secondary-text"/>

                <ComboBox AutomationProperties.AutomationId="DskFileComboBox"
                          AutomationProperties.Name="Disk catalog file"
                          IsVisible="{Binding HasAttachedDiskImage}"
                          ItemsSource="{Binding DskFiles}"
                          SelectedValue="{Binding SelectedDskFile}"
                          DisplayMemberBinding="{Binding Value}"
                          SelectedValueBinding="{Binding Key}"
                          HorizontalAlignment="Stretch"/>

                <Button Content="Load &amp; run file"
                        AutomationProperties.AutomationId="RunDskFileButton"
                        AutomationProperties.Name="Load and run the selected disk file"
                        IsVisible="{Binding HasAttachedDiskImage}"
                        Command="{Binding RunDskFileCommand}"
                        Classes="small"/>

                <TextBlock Text="Assembly example files"
                           Classes="small secondary-text"/>
                <Grid Classes="spacing-tight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              AutomationProperties.AutomationId="AssemblyExampleComboBox"
                              AutomationProperties.Name="Assembly example file"
                              ItemsSource="{Binding AssemblyExamples}"
                              SelectedValue="{Binding SelectedAssemblyExample}"
                              DisplayMemberBinding="{Binding Value}"
                              SelectedValueBinding="{Binding Key}"
                              IsEnabled="{Binding IsFileOperationEnabled}"
                              Classes="small"
                              VerticalAlignment="Stretch"
                              MinWidth="60"/>
                    <Button Grid.Column="1"
                            Content="Load &amp; start"
                            AutomationProperties.AutomationId="LoadAssemblyExampleButton"
                            VerticalAlignment="Stretch"
                            Classes="primary small"
                            Command="{Binding LoadAssemblyExampleCommand}"/>
                </Grid>

                <TextBlock Text="Basic example files"
                           Classes="small secondary-text"/>
                <Grid Classes="spacing-tight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              AutomationProperties.AutomationId="BasicExampleComboBox"
                              AutomationProperties.Name="Basic example file"
                              ItemsSource="{Binding BasicExamples}"
                              SelectedValue="{Binding SelectedBasicExample}"
                              DisplayMemberBinding="{Binding Value}"
                              SelectedValueBinding="{Binding Key}"
                              IsEnabled="{Binding IsFileOperationEnabled}"
                              Classes="small"
                              VerticalAlignment="Stretch"
                              MinWidth="60"/>
                    <Button Grid.Column="1"
                            Content="Load"
                            AutomationProperties.AutomationId="LoadBasicExampleButton"
                            VerticalAlignment="Stretch"
                            Classes="primary small"
                            Command="{Binding LoadBasicExampleCommand}"/>
                </Grid>

                <TextBlock Text="After loading a Basic program, type LIST or RUN at the ] prompt."
                           Classes="small secondary-text"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Configuration -->
        <Button Name="ConfigSectionHeader"
                AutomationProperties.AutomationId="ConfigSectionHeader"
                AutomationProperties.Name="Toggle Configuration section"
                Classes="section-toggle"
                Command="{Binding ToggleConfigSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleRight"
                                         IsVisible="{Binding !IsConfigSectionExpanded}"/>
                    <controls:SymbolIcon Width="8" Height="8"
                                         Kind="TriangleDown"
                                         IsVisible="{Binding IsConfigSectionExpanded}"/>
                </Grid>
                <TextBlock Text="Configuration" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Name="ConfigSectionContent"
                AutomationProperties.AutomationId="ConfigSectionContent"
                Classes="collapsible-content"
                IsVisible="{Binding IsConfigSectionExpanded}">
            <StackPanel Classes="spacing-tight">
                <Button Content="Apple II config…"
                        Name="OpenApple2ConfigButton"
                        AutomationProperties.AutomationId="OpenApple2ConfigButton"
                        AutomationProperties.Name="Open Apple II configuration"
                        Classes="small"
                        IsEnabled="{Binding IsApple2ConfigEnabled}"
                        Click="OpenApple2Config_Click">
                    <!-- Fades the attention pulse the view drives while the config is invalid
                         (missing ROMs). Duration matches ButtonFlashController.FlashOnDuration, so
                         the colour is never yanked back mid-fade. -->
                    <Button.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.7"/>
                        </Transitions>
                    </Button.Transitions>
                </Button>

                <TextBlock Text="ROM files, monitor colour, render provider and CPU compatibility. Only editable while the emulator is stopped."
                           Classes="small secondary-text"
                           TextWrapping="Wrap"/>

                <!-- Live counterpart of the dialog's "Enable keyboard joystick controls": the
                     dialog only opens while the emulator is stopped, so this is the one that can be
                     flipped mid-game. Both write the same persisted setting. -->
                <CheckBox Content="Joystick KB"
                          Name="KeyboardJoystickCheckBox"
                          AutomationProperties.AutomationId="KeyboardJoystickCheckBox"
                          AutomationProperties.Name="Use the keyboard as a joystick"
                          Classes="small"
                          IsChecked="{Binding KeyboardJoystickEnabled, Mode=TwoWay}"/>

                <TextBlock Text="W A S D steer, Space is button 1 and Left Shift is button 2 (some games, e.g. Choplifter, turn with it). Those keys stop reaching the Apple II keyboard while this is on. Mirrors the configuration dialog setting, but changing it here is not saved — press OK in that dialog to keep it."
                           Classes="small secondary-text"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
